---
/* Matchup DNA VS card: portraits, tale of the tape, paired metrics (nulls stay visible), threshold-gated insights. */
import { marketingImage, fmtRecord, fmtInches, titleCase } from "../lib/media";
import { fmtNumber } from "../lib/hl";
export interface Props { matchup: any; compact?: boolean; }
const { matchup: m, compact = false } = Astro.props;
const [A, B] = m.fighters;
const imgA = marketingImage(A.primary_image, A.name), imgB = marketingImage(B.primary_image, B.name);
const ROWS: [string, string, string][] = [["sig_landed_per_min", "Pace (sig. landed/min)", "n"], ["sig_accuracy", "Strike accuracy", "%"], ["distance_attack_share", "Distance share", "%"], ["td_attempts_per_15", "Takedown attempts /15", "n"], ["td_accuracy", "Takedown accuracy", "%"], ["pace_retention_r3_vs_r1", "Pace retention R3/R1", "x"], ["finish_rate", "Finish rate (wins)", "%"]];
const cmp = Object.fromEntries(m.comparisons.map((c: any) => [c.key, c]));
const show = (side: any, u: string) => (!side || side.value === null || side.value === undefined ? "—" : u === "%" ? `${fmtNumber(side.value * 100, 0)}%` : u === "x" ? `${fmtNumber(side.value, 2)}×` : fmtNumber(side.value, 2));
const rank = (f: any) => { const p = (f.ranking?.positions || []).filter((x: any) => !x.is_p4p)[0]; return p ? (p.rank === 0 || p.is_champion ? "Champion" : `#${p.rank} ${titleCase(p.label)}`) : "Unranked"; };
const insights = (m.insights || []).slice(0, compact ? 2 : 4);
---
<div class:list={["vs", { compact }]}>
  <div class="vs-head">
    {[[A, imgA], [B, imgB]].map(([f, img]: any, i) => (
      <div class:list={["vs-fighter", i === 1 ? "right" : ""]}>
        <figure class="fighter-figure"><img src={img.src} srcset={img.srcset} sizes="140px" width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" /><figcaption class="credit">{img.credit ? (img.source_url ? <a href={img.source_url} rel="noopener">{img.credit}</a> : img.credit) : "silhouette"}</figcaption></figure>
        <div><div class="fighter-name">{f.name}</div><div class="fighter-sub">{fmtRecord(f)} · {rank(f)}</div></div>
      </div>
    ))}
    <div class="vs-badge">VS</div>
  </div>
  <table class="tape">
    <tbody>
      <tr><td>{fmtInches(A.reach_in)}</td><th>Reach</th><td>{fmtInches(B.reach_in)}</td></tr>
      <tr><td>{titleCase(A.stance)}</td><th>Stance</th><td>{titleCase(B.stance)}</td></tr>
      {ROWS.map(([k, label, u]) => { const c = cmp[k]; return <tr class:list={[{ lead: c?.direction === "a" ? "a" : c?.direction === "b" ? "b" : "" }]}><td class={c?.direction === "a" ? "win" : ""}>{show(c?.a, u)}</td><th>{label}<small class="muted">{c?.a?.confidence || "—"} / {c?.b?.confidence || "—"}</small></th><td class={c?.direction === "b" ? "win" : ""}>{show(c?.b, u)}</td></tr>; })}
    </tbody>
  </table>
  <div class="vs-meta small muted">Stance context: <b>{m.stance_context.context.replace(/_/g, " ")}</b> · comparisons {m.meta?.comparable}/{m.meta?.comparisons} comparable · as of {typeof m.meta?.resolved_as_of === "object" ? `${m.meta.resolved_as_of.a} / ${m.meta.resolved_as_of.b}` : m.meta?.resolved_as_of}. “—” means no stat-covered rounds for that fighter; nothing is estimated. Reach, stance and rank come from <code>/fighters/{"{id}"}</code>; every metric row comes from the matchup response.</div>
  {insights.length > 0 && (
    <div class="reads">
      <div class="eyebrow gold" style="margin:0 0 6px">Matchup read <span class="chip derived">PBE derived</span></div>
      <ul>{insights.map((i: any) => <li><b>{i.label}.</b> {i.explanation} <span class={`conf conf-${i.confidence}`}>{i.confidence}</span></li>)}</ul>
      {m.warnings?.length > 0 && <div class="small muted">{m.warnings.length} threshold{m.warnings.length === 1 ? "" : "s"} not met are listed in <code>warnings[]</code> instead of being guessed.</div>}
      <div class="small muted">{m.note}</div>
    </div>
  )}
</div>
