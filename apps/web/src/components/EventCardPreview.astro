---
/* Rendered fight card from /events/{id}/card. */
import { fmtRecord, titleCase } from "../lib/media";
import FighterImage from "./FighterImage.astro";
import { fmtDate } from "../lib/hl";
export interface Props { event: any; limit?: number; compact?: boolean; }
const { event: e, limit = 6, compact = false } = Astro.props;
const bouts = [...e.bouts].sort((a, b) => b.bout_order - a.bout_order);
const main = bouts[0];
const rest = bouts.slice(1, limit);
const groups = ["main", "prelim", "early_prelim"];
---
<div class:list={["card-preview", { compact }]}>
  <div class="event-head">
    <div>
      <div class="eyebrow" style="margin:0">{fmtDate(e.event.event_date)} · {e.event.venue}{e.event.city ? `, ${e.event.city}` : ""}{e.event.region ? `, ${e.event.region}` : ""}</div>
      <h3 style="margin:4px 0 0">{e.event.name}</h3>
    </div>
    <div class="event-meta mono small"><span class="chip">{e.event.card_status}</span> <span>{e.bout_count} bouts</span></div>
  </div>
  {main && (
    <div class="main-event">
      <div class="eyebrow gold" style="margin:0 0 8px">Main event · {titleCase(main.weight_class)}{main.is_title ? " · Title" : ""} · {main.scheduled_rounds} rounds</div>
      <div class="main-row">
        {[main.fighter_a, main.fighter_b].map((f: any, i) => { return (
          <div class:list={["main-side", i === 1 ? "right" : ""]}>
            <FighterImage fighter={f} sizes="96px" />
            <div><div class="fighter-name">{f.name}</div><div class="fighter-sub">{fmtRecord(f)} · {titleCase(f.stance)}</div></div>
          </div>
        ); })}
        <div class="vs-badge">VS</div>
      </div>
    </div>
  )}
  <ol class="bout-list">
    {rest.map((b: any) => (
      <li>
        <span class="mono small muted">{b.card_position ? titleCase(b.card_position) : ""}</span>
        <span class="bout-names">{b.fighter_a.name} <em>vs</em> {b.fighter_b.name}</span>
        <span class="small muted">{titleCase(b.weight_class)}{b.is_womens ? " (W)" : ""}</span>
      </li>
    ))}
  </ol>
  {bouts.length > limit && <div class="small muted">+ {bouts.length - limit} more bouts on the card</div>}
</div>
