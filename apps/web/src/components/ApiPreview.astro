---
/* Wrapper: endpoint request (compact) + rendered preview (slot) + JSON drawer. The API → product-UI mapping in one block. */
import ApiRequest from "./ApiRequest.astro";
import JsonDrawer from "./JsonDrawer.astro";
export interface Props { path: string; plan?: string | null; json?: unknown; title?: string; note?: string; captured?: string; hideRequest?: boolean; }
/* `captured` marks a pinned documentation fixture (SCHEMA EXAMPLE), never a live-cadence value.
   Live-cadence surfaces use Demo with source="live", which reads the generated showcase snapshot. */
const { path, plan = null, json, title = "Rendered from the response", note, captured, hideRequest = false } = Astro.props;
---
<div class="api-preview">
  {!hideRequest && <ApiRequest path={path} plan={plan} compact />}
  <div class="api-preview-body">
    <div class="api-preview-bar"><span class="eyebrow" style="margin:0">{title}</span>{captured && <span class="mono small muted" title="A response captured from the canonical API and pinned as a documentation fixture. It shows the exact shape and semantics of the endpoint; it is not refreshed on the live cadence.">schema example · captured {captured}</span>}{json !== undefined && <JsonDrawer json={json} path={path} title="Response JSON" note={note} />}</div>
    <slot />
  </div>
</div>
