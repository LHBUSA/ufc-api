---
/* Rendered rankings division: champion stage + ranked list. Media resolves through the shared policy, so a
   fighter with a portrait on the consumer rankings has one here too. */
import { fighterMedia } from "../lib/media";
import FighterImage from "./FighterImage.astro";
export interface Props { rankings: any; limit?: number; }
const { rankings: r, limit = 8 } = Astro.props;
const d = r.division;
/* Rankings rows join to media by canonical fighter id / slug_id, exactly like every other surface,
   so a fighter with a portrait on the consumer rankings has one here too. */
const asFighter = (e: any) => ({ id: e.fighter_id ?? e.id ?? null, name: e.name, slug_id: e.slug_id ?? null, primary_image: e.primary_image ?? null, media: e.media ?? null });
const champ = d.champion ? asFighter(d.champion) : null;
const champImg = champ ? fighterMedia(champ) : null;
const entries = d.entries.slice(0, limit).map((e: any) => ({ ...e, f: asFighter(e) }));
const anyImg = (champImg?.approved ?? false) || entries.some((e: any) => fighterMedia(e.f).approved);
---
<div class="card-preview rank-preview">
  <div class="event-head">
    <div><div class="eyebrow" style="margin:0">{d.label}{d.is_womens ? " · Women's" : ""}</div><div class="mono small muted" style="margin-top:4px">Official snapshot {r.snapshot_date}</div></div>
    <div class="event-meta"><span class="chip source">Source</span><a href={r.source_url} rel="noopener">ufc.com</a></div>
  </div>
  {d.champion && (
    <div class="rank-champ">
      {champ && <FighterImage fighter={champ} sizes="110px" />}
      <div>
        <div class="t">Champion</div>
        <div class="n">{d.champion.name}</div>
        {champImg?.credit && <div class="credit">{champImg.source_url ? <a href={champImg.source_url} rel="noopener">{champImg.credit}</a> : champImg.credit}</div>}
      </div>
    </div>
  )}
  <ol class="rank-list">
    {entries.map((e: any) => (
      <li class:list={[{ "no-img": !anyImg }]}>
        <span class="rank-n">{e.rank}</span>
        {anyImg && <FighterImage fighter={e.f} sizes="40px" />}
        <span class="rank-name">{e.name}{e.is_new && <span class="chip" style="margin-left:8px">New</span>}</span>
        <span class:list={["rank-move", e.change > 0 ? "up" : e.change < 0 ? "down" : ""]}>{e.change > 0 ? `▲ ${e.change}` : e.change < 0 ? `▼ ${Math.abs(e.change)}` : "—"}</span>
      </li>
    ))}
  </ol>
</div>
