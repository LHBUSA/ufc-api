            <tr><td><span class="chip media">Media</span></td><td>primary_image, images[], hero_image</td><td>Render <code>attribution_text</code>; each file's license governs reuse.</td></tr>
            <tr><td><span class="chip link">Third-party link</span></td><td>videos, wire</td><td>Ids and official URLs only. Provider player; never rehost.</td></tr>
