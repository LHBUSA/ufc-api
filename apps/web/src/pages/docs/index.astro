---
import Base from "../../layouts/Base.astro";
import ApiRequest from "../../components/ApiRequest.astro";
import ApiPreview from "../../components/ApiPreview.astro";
import JsonDrawer from "../../components/JsonDrawer.astro";
import Code from "../../components/Code.astro";
import FighterPreview from "../../components/FighterPreview.astro";
import FightDnaPreview from "../../components/FightDnaPreview.astro";
import MatchupPreview from "../../components/MatchupPreview.astro";
import EventCardPreview from "../../components/EventCardPreview.astro";
import RankingsPreview from "../../components/RankingsPreview.astro";
import gen from "../../generated/entitlements.json";
import ex from "../../generated/examples.json";
import { fmtDate, fmtNumber } from "../../lib/hl";

const plans = gen.plans.plans;
const order = gen.plans.plan_order;
const contract = gen.contract;
const matrix = gen.matrix;
const reg = ex.dna_registry;
const sc = ex.showcase;
const S = sc.hero.fighter.id, FIOROT = sc.fiorot.fighter.id, GRASSO = sc.grasso.fighter.id, EVENT = sc.event.event.id;
const planName = (k: string | null) => (k ? plans[k as keyof typeof plans]?.name : "Enterprise");
const minPlan = (key: string) => matrix.find((x) => x.key === key)?.minimum_plan || "enterprise";
const captured = fmtDate(ex.fighter_dna.captured_at);
/* compact JSON excerpts: verbatim subsets */
const eventsExcerpt = { ok: true, data: ex.events_upcoming.body.data.slice(0, 2), meta: ex.events_upcoming.body.meta };
const fighterExcerpt = { ...ex.fiorot_detail.body, data: { ...ex.fiorot_detail.body.data, images: undefined, history: undefined, ranking: undefined } };
const dnaExcerpt = (() => { const s = ex.fighter_dna.body.data.snapshot; return { ok: true, data: { fighter: { id: ex.fighter_dna.body.data.fighter.id, name: ex.fighter_dna.body.data.fighter.name }, snapshot: { as_of_date: s.as_of_date, definition_version: s.definition_version, sample_bouts: s.sample_bouts, sample_rounds: s.sample_rounds, sample_seconds: s.sample_seconds, coverage_status: s.coverage_status, metrics: { sig_landed_per_min: s.metrics.sig_landed_per_min, finish_rate: s.metrics.finish_rate, "…": "more metric keys" }, "…": "stance_splits, round_profile, finish_profile, context_splits, provenance" } }, meta: ex.fighter_dna.body.meta }; })();
const matchupExcerpt = { ok: true, data: { fighters: ex.matchup_comain.body.data.fighters.map((f: any) => ({ id: f.id, name: f.name, stance: f.stance })), comparisons: ex.matchup_comain.body.data.comparisons.slice(0, 2), insights: ex.matchup_comain.body.data.insights.slice(0, 1), warnings: ex.matchup_comain.body.data.warnings.slice(0, 2), "…": "stance_context, bettors_edge_evidence, note" }, meta: { resolved_as_of: ex.matchup_comain.body.meta.resolved_as_of, insights: ex.matchup_comain.body.meta.insights, warnings: ex.matchup_comain.body.meta.warnings } };
const cardExcerpt = { ok: true, data: { event: ex.noche_card.body.data.event, bouts: ex.noche_card.body.data.bouts.slice(0, 1).map((b: any) => ({ id: b.id, bout_order: b.bout_order, weight_class: b.weight_class, scheduled_rounds: b.scheduled_rounds, fighter_a: { id: b.fighter_a.id, name: b.fighter_a.name, "…": "record, stance, primary_image" }, fighter_b: { id: b.fighter_b.id, name: b.fighter_b.name, "…": "…" }, result: b.result })), "…": "12 more bouts" }, meta: ex.noche_card.body.meta };
const rankExcerpt = ex.rankings_featherweight.body;
const nav = [
  ["Get started", [["quickstart", "Quickstart"], ["authentication", "Authentication"], ["api-keys", "API keys"], ["plans", "Plans & limits"], ["errors", "Errors"]]],
  ["Core data", [["events", "Events"], ["cards", "Cards"], ["fighters", "Fighters"], ["bouts", "Bouts & round stats"], ["results", "Results"], ["rankings", "Rankings"], ["media", "Media"]]],
  ["Intelligence", [["fight-dna", "Fight DNA"], ["matchup-dna", "Matchup DNA"], ["as-of", "As-of snapshots"], ["confidence", "Confidence"], ["provenance", "Provenance"]]],
  ["Build guides", [["guide-fighter", "Build a fighter profile"], ["guide-card", "Build a fight card"], ["guide-compare", "Compare two fighters"], ["guide-rankings", "Build a rankings screen"], ["guide-fight-week", "Build a Fight Week app"]]],
  ["Reference", [["endpoints", "Endpoint reference"], ["origin-labels", "Origin labels"], ["schemas", "Schemas & OpenAPI"]]],
];
const gatewayErrors = [["401", "api_key_required", "No credential sent."], ["401", "invalid_api_key", "Malformed or unknown key, or secret mismatch."], ["401", "api_key_expired", "Key past expires_at."], ["401", "api_key_revoked", "Key revoked or rotated."], ["401", "api_key_suspended", "Subscription not active (unpaid, canceled). Manage it in the dashboard."], ["403", "plan_required", "Endpoint or parameter needs a higher plan; detail carries required_plan, current_plan, upgrade_url."], ["404", "route_not_found", "Path is not part of the commercial contract (no upstream call is made)."], ["429", "rate_limited", "Per-minute limit hit; Retry-After set."], ["429", "quota_exceeded", "Monthly quota hit on a hard-limit plan; Retry-After set."], ["502 / 504", "upstream_unavailable / upstream_timeout", "Canonical API unreachable or slow."]];
const upstreamErrors = [["400", "invalid_include · invalid_ids · too_many_ids · invalid_as_of · invalid_stance · invalid_metric · invalid_bound · invalid_confidence · invalid_type · invalid_fighter_id · invalid_matchup", "Validation errors from the canonical API; detail lists allowed values."], ["404", "event_not_found · fighter_not_found · bout_not_found · article_not_found · division_not_found", "Unknown entity."], ["404", "dna_not_available", "No Fight DNA snapshot for the fighter (or none at/before as_of). detail.reason: no_snapshot | no_snapshot_at_or_before_as_of."], ["503", "rankings_not_available · dna_not_available · ledger_not_available · videos_not_available", "The store does not exist yet; data is null, nothing is synthesized."]];
const jsonLd = [{ "@context": "https://schema.org", "@type": "TechArticle", headline: "UFC Intelligence API documentation", url: "https://ufc.proptechusa.ai/docs", about: { "@id": "https://ufc.proptechusa.ai/#app" }, publisher: { "@id": "https://proptechusa.ai/#organization" }, dateModified: ex.fighter_dna.captured_at, proficiencyLevel: "Beginner", description: "Quickstart, authentication, plans, core data, Fight DNA, Matchup DNA, as-of snapshots, build guides and the endpoint reference." }];
---
<Base title="UFC API Documentation | PropTechUSA.ai" description="Quickstart, authentication, plans, core UFC data, Fight DNA, Matchup DNA, as-of snapshots, confidence, provenance, build guides and the endpoint reference for the PropTechUSA UFC Intelligence API." path="/docs" jsonLd={jsonLd} breadcrumbs={[{ name: "Docs", path: "/docs" }]}>
  <div class="wrap docs">
    <aside class="docs-nav" aria-label="Documentation sections">
      {nav.map(([h, items]: any) => (<><h5>{h}</h5>{items.map(([id, l]: any) => <a href={`#${id}`}>{l}</a>)}</>))}
      <h5>More</h5>
      <a href="/docs/reference">Interactive reference</a>
      <a href="/openapi.json">openapi.json</a>
      <a href="/workspace">Workspace</a>
      <a href="/learn/fight-dna">Fight DNA methodology</a>
    </aside>
    <div class="docs-body">
      <p class="eyebrow">Documentation</p>
      <h1 style="font-size:clamp(2rem,4vw,3rem)">UFC Intelligence API</h1>
      <p class="lede">Base URL <code>https://ufc.proptechusa.ai</code>. Data contract <code>{contract.api_version}</code>, Fight DNA definitions v{contract.fight_dna_definition_version}. Every response is <code>{`{ ok, data, meta }`}</code> or <code>{`{ ok:false, data:null, error, meta }`}</code>. Every example below is a <b>schema example</b>: a real response captured from the canonical API on {captured} and pinned here, so the shape, field names and semantics you read are exactly what you receive. Pinned examples do not move. For values on the published refresh cadence, see the <a href="/">live demos on the home page</a>, which carry their own capture time and freshness state. Each important endpoint shows <b>request → response → what you can build</b>.</p>

      <section id="quickstart">
        <h2>Quickstart <span class={`chip plan-${minPlan("events")}`}>{planName(minPlan("events"))}+</span></h2>
        <ol>
          <li><a href="/pricing">Buy a plan</a>. Your key (<code>pt_ufc_live_&lt;id&gt;_&lt;secret&gt;</code>) is provisioned automatically and shown once on the dashboard.</li>
          <li>Export it: <code>export UFC_API_KEY=pt_ufc_live_…</code></li>
          <li>Call the API:</li>
        </ol>
        <ApiRequest path="/v1/ufc/events?status=upcoming&limit=3" plan="developer" />
        <p>Read <code>data</code>; keep <code>meta.request_id</code> for support; watch <code>X-Quota-Remaining</code>. Or skip the terminal: <a href="/workspace">open the Workspace</a>, paste your key and run the current card.</p>
        <div class="callout">The gateway exposes exactly the 34 endpoints in the <a href="#endpoints">reference</a>. Routes above your plan return <code>403 plan_required</code>; anything else under <code>/v1</code> is <code>404 route_not_found</code>.</div>
      </section>

      <section id="authentication">
        <h2>Authentication</h2>
        <Code shell={`curl -H "Authorization: Bearer $UFC_API_KEY" https://ufc.proptechusa.ai/v1/ufc\n# equivalent\ncurl -H "X-API-Key: $UFC_API_KEY" https://ufc.proptechusa.ai/v1/ufc`} title="auth" />
        <ul>
          <li>Bearer token (preferred) or <code>X-API-Key</code>. The key id (12 characters after <code>pt_ufc_live_</code>) is safe to log; the secret is not.</li>
          <li>Call from your server or edge function. CORS is enabled for tooling, not as a credential model; never ship a key in browser code.</li>
          <li>Failures: <code>401 api_key_required</code>, <code>invalid_api_key</code>, <code>api_key_expired</code>, <code>api_key_revoked</code>, <code>api_key_suspended</code>.</li>
        </ul>
      </section>

      <section id="api-keys">
        <h2>API keys</h2>
        <p>One key per subscription, tied to a plan and a channel. Manage it on the <a href="/dashboard">dashboard</a>: copy, rotate (new secret issued once, old key revoked immediately, subscription stays attached), see usage, denied requests and recent calls, and open the Stripe customer portal. Enterprise keys can carry per-key overrides for quota and rate limit.</p>
      </section>

      <section id="plans">
        <h2>Plans and limits</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Plan</th><th>Price</th><th>Requests / month</th><th>Requests / minute</th><th>At the limit</th><th>Unlocks</th></tr></thead>
          <tbody>{order.map((k) => { const p = plans[k as keyof typeof plans]; return <tr><td>{p.name}</td><td>{p.price_usd_month === null ? (p as any).price_label : `$${p.price_usd_month}/mo`}</td><td>{p.included_requests === null ? "custom" : fmtNumber(p.included_requests)}</td><td>{p.rate_limit_per_min ?? "custom"}</td><td>{p.limit_mode === "hard" ? "429 quota_exceeded" : p.limit_mode === "soft" ? "allowed, X-Quota-Status: over-quota-soft" : "custom"}</td><td class="small">{p.tagline}</td></tr>; })}</tbody>
        </table></div>
        <p>Headers on every response: <code>X-Request-Id</code>, <code>X-Upstream-Request-Id</code>, <code>X-API-Version</code>, <code>X-Gateway-Version</code>, <code>X-Plan</code>, <code>X-RateLimit-Limit/Remaining/Reset</code>, <code>X-Quota-Limit/Remaining/Reset</code>, <code>Retry-After</code> (429 only). Denied requests never consume quota. <code>Cache-Control: private, max-age=N</code> mirrors canonical freshness: short for upcoming cards, rankings and search; longer for history and as-of DNA.</p>
      </section>

      <section id="errors">
        <h2>Errors</h2>
        <div class="table-wrap"><table><thead><tr><th>Status</th><th>Code</th><th>Meaning</th></tr></thead><tbody>{gatewayErrors.map(([s, c, m]) => <tr><td><code>{s}</code></td><td><code>{c}</code></td><td>{m}</td></tr>)}</tbody></table></div>
        <p style="margin-top:12px">Canonical API errors pass through unchanged:</p>
        <div class="table-wrap"><table><thead><tr><th>Status</th><th>Codes</th><th>Meaning</th></tr></thead><tbody>{upstreamErrors.map(([s, c, m]) => <tr><td><code>{s}</code></td><td class="small mono">{c}</td><td>{m}</td></tr>)}</tbody></table></div>
        <div class="callout red">Missing data is never a 200 with fake zeroes. You get <code>null</code>, an explicit <code>status</code>, or a 404/503 with a reason.</div>
      </section>

      <section id="events">
        <h2>Events <span class="chip plan-developer">Developer+</span> <span class="chip source">Source</span></h2>
        <p><code>GET /v1/ufc/events?status=upcoming|recent|all&amp;date=YYYY-MM-DD&amp;limit=N</code>, then <code>GET /v1/ufc/events/{`{id}`}</code> by UUID, UFCStats id or ESPN event id.</p>
        <ApiPreview path="/v1/ufc/events?status=upcoming&limit=3" plan="developer" json={ex.events_upcoming.body} captured={fmtDate(ex.events_upcoming.captured_at)} title="Response excerpt → schedule list">
          <Code json={eventsExcerpt} title="excerpt" />
          <div class="table-wrap" style="margin-top:10px"><table><thead><tr><th>Date</th><th>Event</th><th>Venue</th><th>Status</th></tr></thead><tbody>{ex.events_upcoming.body.data.map((e: any) => <tr><td class="mono small">{e.event_date}</td><td><b>{e.name}</b></td><td class="small">{e.venue}, {e.city}</td><td><span class="chip">{e.card_status}</span></td></tr>)}</tbody></table></div>
        </ApiPreview>
      </section>

      <section id="cards">
        <h2>Cards <span class="chip plan-developer">Developer+</span></h2>
        <p><code>GET /v1/ufc/events/{`{id}`}/card?include=media,results,stats</code> returns <code>event</code> plus ordered <code>bouts[]</code> with both fighters, images and results. <code>include=stats</code> (round rows per bout) requires <b>Pro</b>.</p>
        <ApiPreview path={`/v1/ufc/events/${EVENT}/card`} plan="developer" json={ex.noche_card.body} captured={fmtDate(sc.event.captured_at)} title="Response excerpt → rendered fight card" note="subset: 2 of 13 bouts">
          <Code json={cardExcerpt} title="excerpt" />
          <div class="demo" style="margin-top:12px;padding:14px"><EventCardPreview event={sc.event} limit={5} /></div>
        </ApiPreview>
      </section>

      <section id="fighters">
        <h2>Fighters <span class="chip plan-developer">Developer+</span></h2>
        <p><code>GET /v1/ufc/fighters?q=&amp;active=true</code> to search, <code>GET /v1/ufc/fighters/{`{id}`}?include=media,ranking,next,history,stats,videos</code> for the composite profile (ids: UUID, UFCStats or ESPN athlete id). <code>include=stats</code> requires Pro. History: <code>/fighters/{`{id}`}/history?limit=</code>.</p>
        <ApiPreview path={`/v1/ufc/fighters/${FIOROT}?include=ranking,next,history&history_limit=5`} plan="developer" json={ex.fiorot_detail.body} captured={fmtDate(sc.fiorot.captured_at)} title="Response excerpt → fighter profile" note="subset">
          <Code json={fighterExcerpt} title="excerpt" />
          <div class="demo" style="margin-top:12px;padding:14px"><FighterPreview fighter={sc.fiorot.fighter} size="card" showCareer /></div>
        </ApiPreview>
      </section>

      <section id="bouts">
        <h2>Bouts and round stats <span class="chip plan-developer">Developer+</span> <span class="chip source">Source</span></h2>
        <p><code>GET /v1/ufc/bouts/{`{id}`}</code> for one bout; <code>GET /v1/ufc/bouts/{`{id}`}/stats</code> for every UFC Stats round row (<code>kd</code>, <code>sig_str_*</code>, <code>total_str_*</code>, <code>td_*</code>, <code>sub_att</code>, <code>rev</code>, <code>ctrl_sec</code>, head/body/leg and distance/clinch/ground splits) plus per-fighter totals, <code>fight_time_sec</code> and provenance. Bouts without rows return empty arrays. Career aggregates with computed rates: <code>GET /v1/ufc/fighters/{`{id}`}/stats</code> (Pro).</p>
        <ApiRequest path={`/v1/ufc/fighters/${S}/stats`} plan="pro" compact />
        <div style="margin-top:8px"><JsonDrawer json={ex.fighter_stats.body} path={`/v1/ufc/fighters/${S}/stats`} title="Career stats response" note="subset: 2 round rows, 1 bout" label="View full response →" /></div>
      </section>

      <section id="results">
        <h2>Results <span class="chip plan-developer">Developer+</span></h2>
        <p><code>GET /v1/ufc/results?limit=N</code>: most recent completed bouts with winner, method, round and time. Results are ESPN-sourced facts; a bout without a result has <code>result: null</code>.</p>
        <ApiRequest path="/v1/ufc/results?limit=10" plan="developer" compact />
        <div style="margin-top:8px"><JsonDrawer json={ex.results.body} path="/v1/ufc/results?limit=2" title="Results response" label="View response →" /></div>
      </section>

      <section id="rankings">
        <h2>Rankings <span class="chip plan-developer">Developer+</span> <span class="chip source">Source</span></h2>
        <p><code>GET /v1/ufc/rankings?division=&amp;womens=</code>: the verified ufc.com snapshot with per-division champion and entries, linked to canonical fighter ids. Attribution is required: render <code>source</code> and <code>source_url</code>. <code>503 rankings_not_available</code> when no store exists.</p>
        <ApiPreview path="/v1/ufc/rankings?division=FEATHERWEIGHT" plan="developer" json={rankExcerpt} captured={fmtDate(sc.rankings_featherweight.captured_at)} title="Response → rankings screen" note="subset: 3 entries">
          <div class="demo" style="padding:14px"><RankingsPreview rankings={sc.rankings_featherweight} limit={6} /></div>
        </ApiPreview>
      </section>

      <section id="media">
        <h2>Media <span class="chip plan-developer">Developer+</span> <span class="chip media">Media</span></h2>
        <p>Fighter rows carry <code>primary_image</code> (<code>image_url</code>, <code>card_url</code> 800×1000, <code>thumb_url</code> 320×400) with <code>author</code>, <code>license</code>, <code>source_url</code>, <code>kind</code>, <code>attribution_text</code> and <code>rights_label</code>; fighter detail adds <code>images[]</code>; <code>GET /v1/ufc/fighters/media?ids=…</code> maps up to 150 ids. <b>Render the credit wherever the image is shown; the file's license governs reuse.</b> Official video metadata (<code>/videos</code>, <code>/fighters/{`{id}`}/videos</code>, <code>/events/{`{id}`}/videos</code>) returns ids, official URLs, <code>embed_url</code> and <code>attribution</code>; play through the provider, never rehost.</p>
        <Code json={sc.fiorot.fighter.primary_image} title="primary_image (live)" />
      </section>

      <section id="fight-dna">
        <h2>Fight DNA <span class="chip plan-pro">Pro+</span> <span class="chip derived">PBE derived</span></h2>
        <p><code>GET /v1/ufc/fighters/{`{id}`}/dna[?as_of=YYYY-MM-DD]</code>: the fighter's snapshot with <code>metrics</code> (striking, pace, grappling, finish), <code>stance_splits</code>, <code>round_profile</code>, <code>finish_profile</code>, <code>context_splits</code>, <code>position_profile</code> and <code>provenance</code>. Family routes: <code>/splits?opponent_stance=</code>, <code>/round-profile</code>, <code>/finish-profile</code>, <code>/position-profile</code>. Definitions for every metric: <code>GET /v1/ufc/dna/metrics</code> (all plans).</p>
        <ApiPreview path={`/v1/ufc/fighters/${S}/dna`} plan="pro" json={ex.fighter_dna.body} captured={captured} title="Response excerpt → Fight DNA panel" note="subset">
          <Code json={dnaExcerpt} title="excerpt" />
          <div class="demo" style="margin-top:12px;padding:14px"><FighterPreview fighter={sc.hero.fighter} size="mini" nextBout={false} /><div style="height:10px"></div><FightDnaPreview snapshot={sc.hero.dna} /></div>
        </ApiPreview>
        <p class="small muted" style="margin-top:10px">Registry families: {Object.keys(reg?.families || {}).join(", ")}. See the <a href="/learn/fight-dna">methodology</a> for every definition.</p>
      </section>

      <section id="matchup-dna">
        <h2>Matchup DNA <span class="chip plan-ultra">Ultra+</span> <span class="chip derived">PBE derived</span></h2>
        <p><code>GET /v1/ufc/matchups/{`{a}`}/{`{b}`}/dna[?as_of=]</code> compares {ex.matchup_meta?.comparisons?.length} paired metrics (<code>delta</code>, <code>direction</code>, <code>comparable</code>), adds <code>stance_context</code>, and emits <code>insights[]</code> only above the thresholds in <code>meta.insight_rules</code>; the rest is named in <code>warnings[]</code>. Also Ultra: <code>/dna/query</code>, <code>/bouts/{`{id}`}/ledger</code>, <code>/events/{`{id}`}/intelligence</code>.</p>
        <ApiPreview path={`/v1/ufc/matchups/${FIOROT}/${GRASSO}/dna`} plan="ultra" json={ex.matchup_comain.body} captured={fmtDate(sc.comain.captured_at)} title="Response excerpt → matchup card" note="subset">
          <Code json={matchupExcerpt} title="excerpt" />
          <div class="demo" style="margin-top:12px;padding:14px"><MatchupPreview matchup={sc.comain} compact /></div>
        </ApiPreview>
      </section>

      <section id="as-of">
        <h2>As-of snapshots <span class="chip plan-pro">Pro+</span></h2>
        <p>{reg?.as_of_semantics}</p>
        <p>Add <code>?as_of=YYYY-MM-DD</code> to fighter DNA routes (Pro) or Matchup DNA (Ultra). <code>meta.requested_as_of</code> / <code>meta.resolved_as_of</code> report the snapshot used. A date before the first snapshot is a truthful 404:</p>
        <Code json={ex.fighter_dna_asof_404.body} title="404 dna_not_available (live)" />
      </section>

      <section id="confidence">
        <h2>Confidence</h2>
        <div class="table-wrap"><table><thead><tr><th>Tier</th><th>Rule</th></tr></thead><tbody>{Object.entries(reg?.confidence_tiers || {}).map(([k, v]) => <tr><td><code>{k}</code></td><td>{v as string}</td></tr>)}</tbody></table></div>
        <p><code>coverage_status</code> uses the same scale for stat coverage of the sample. Present <code>insufficient</code> and <code>low</code> as exactly that.</p>
      </section>

      <section id="provenance">
        <h2>Provenance</h2>
        <p>Every derived value is a <code>MetricObject</code>; the gateway never strips it.</p>
        <Code json={contract.metric_object_sample} title="MetricObject (live)" />
      </section>

      <section id="guide-fighter">
        <h2>Build a fighter profile</h2>
        <ol>
          <li><b>Find the fighter</b>: <code>GET /v1/ufc/fighters?q=fiorot</code> → take <code>id</code> (or accept a UFCStats / ESPN id directly).</li>
          <li><b>Profile</b>: <code>GET /v1/ufc/fighters/{`{id}`}?include=ranking,next,history&amp;history_limit=10</code> → name, record, height/reach/stance, <code>primary_image</code> (+ credit), ranking positions, next bout, recent history.</li>
          <li><b>Career stats</b> (Pro): <code>GET /v1/ufc/fighters/{`{id}`}/stats</code> → <code>computed.career_rates</code> with provenance; label as display aggregates.</li>
          <li><b>Fight DNA</b> (Pro): <code>GET /v1/ufc/fighters/{`{id}`}/dna</code> → render metrics with their confidence; show the sample line; hide nothing.</li>
        </ol>
        <p>Result: the <a href="/#fighter-profile">fighter profile demo</a> on the homepage, rendered from exactly these responses. Try it live in the <a href={`/workspace?tool=fighter&id=${FIOROT}`}>Workspace</a>.</p>
      </section>

      <section id="guide-card">
        <h2>Build a fight card</h2>
        <ol>
          <li><code>GET /v1/ufc/events?status=upcoming&amp;limit=1</code> → the next event id.</li>
          <li><code>GET /v1/ufc/events/{`{id}`}/card?include=media,results</code> → <code>bouts[]</code> ordered main event first (<code>bout_order</code>), with <code>card_position</code> (main, prelim, early_prelim), weight class, scheduled rounds, title flag, both fighters with images, and <code>result</code> when fought.</li>
          <li>Group by <code>card_position</code>; render the highest <code>bout_order</code> as the main event; credit every portrait.</li>
          <li>Optional: <code>GET /v1/ufc/events/{`{id}`}/videos</code> for the official fight-week video timeline (link out, never rehost).</li>
        </ol>
        <p>See <a href="/#fight-week">Fight Week</a> on the homepage or run <a href="/workspace?tool=card">Current card</a> in the Workspace.</p>
      </section>

      <section id="guide-compare">
        <h2>Compare two fighters</h2>
        <ol>
          <li>Resolve both ids by search.</li>
          <li><code>GET /v1/ufc/matchups/{`{a}`}/{`{b}`}/dna</code> (Ultra).</li>
          <li>Tale of the tape from <code>fighters[]</code> (reach, stance, record, rank); paired rows from <code>comparisons[]</code> (<code>comparable=false</code> → show “—”, never a placeholder number); <code>stance_context</code> for the stance story.</li>
          <li>Render <code>insights[]</code> as the read, each with its confidence and sample; surface <code>warnings[]</code> so users see what was <em>not</em> claimed.</li>
        </ol>
        <p>Live: <a href={`/workspace?tool=matchup&a=${FIOROT}&b=${GRASSO}`}>Workspace matchup builder</a>.</p>
      </section>

      <section id="guide-rankings">
        <h2>Build a rankings screen</h2>
        <ol>
          <li><code>GET /v1/ufc/rankings</code> (all divisions, official order) or <code>?division=FEATHERWEIGHT</code>.</li>
          <li>Champion card from <code>champion</code>; list from <code>entries[]</code> with <code>rank</code>, <code>change</code>, <code>is_new</code>; ties are real, ranks may skip.</li>
          <li>Portraits: collect <code>fighter.id</code> values and call <code>GET /v1/ufc/fighters/media?ids=a,b,c</code> (≤150) once; render credits.</li>
          <li>Show <code>source</code> / <code>source_url</code> (ufc.com) and <code>snapshot_date</code>.</li>
        </ol>
      </section>

      <section id="guide-fight-week">
        <h2>Build a Fight Week app</h2>
        <ol>
          <li>Card: steps from <a href="#guide-card">Build a fight card</a>.</li>
          <li>Faces and profiles: <code>/fighters/{`{id}`}</code> per bout (or reuse card payload).</li>
          <li>Intelligence: <code>/fighters/{`{id}`}/dna</code> (Pro) for each side; <code>/matchups/{`{a}`}/{`{b}`}/dna</code> (Ultra) for the read; <code>/events/{`{id}`}/intelligence</code> (Ultra) for the ledger view across the card.</li>
          <li>Context: <code>/rankings</code> for implications, <code>/events/{`{id}`}/videos</code> for official media, <code>/news</code> for PropBetEdge editorial.</li>
        </ol>
        <p>PropBetEdge UFC's <a href="https://ufc.propbetedge.ai" rel="noopener">Fight Week</a> is one production implementation of this flow.</p>
      </section>

