---
import Base from "../../layouts/Base.astro";
---
<Base title="UFC API Reference — All 39 Endpoints | PropTechUSA" description="Interactive OpenAPI reference for all 39 commercial UFC Intelligence API endpoints, including plan requirements, schemas, Fight DNA, Matchup DNA, fight-week intelligence and examples." path="/docs/reference">
  <section class="section tight">
    <div class="wrap">
      <p class="eyebrow">Reference</p>
      <h1 style="font-size:clamp(1.8rem,3.5vw,2.6rem)">All 39 commercial endpoints</h1>
      <p class="lede">Rendered from <a href="/openapi.json">/openapi.json</a>, the commercial OpenAPI 3.1 contract. Each operation shows its minimum plan (<code>x-plan</code>), origin label and a pinned schema example. Examples show response shape, not live-cadence values. Set your key under <em>Authentication</em> to try requests against the gateway. <a href="/docs">Back to the guide →</a></p>
    </div>
  </section>
  <div id="api-reference" data-url="/openapi.json" data-configuration='{"theme":"default","layout":"modern","darkMode":false,"forceDarkModeState":"light","hideDarkModeToggle":true,"hideDownloadButton":false,"showSidebar":true,"authentication":{"preferredSecurityScheme":"BearerAuth"},"defaultOpenAllTags":false,"hideModels":false}'></div>
  <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.68.0/dist/browser/standalone.js" is:inline></script>
</Base>
