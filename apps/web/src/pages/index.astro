---
import Base from "../layouts/Base.astro";
import ApiRequest from "../components/ApiRequest.astro";
import JsonDrawer from "../components/JsonDrawer.astro";
import Demo from "../components/Demo.astro";
import VideoDesk from "../components/VideoDesk.astro";
import FightPoster from "../components/FightPoster.astro";
import FighterPreview from "../components/FighterPreview.astro";
import FightDnaPreview from "../components/FightDnaPreview.astro";
import MatchupPreview from "../components/MatchupPreview.astro";
import EventCardPreview from "../components/EventCardPreview.astro";
import RankingsPreview from "../components/RankingsPreview.astro";
import ReceiptPreview from "../components/ReceiptPreview.astro";
import WeighInPreview from "../components/WeighInPreview.astro";
import SupersessionChain from "../components/SupersessionChain.astro";
import gen from "../generated/entitlements.json";
import show from "../generated/showcase.json";
import { fmtDate, fmtNumber } from "../lib/hl";
import { freshness } from "../lib/freshness";

const plans = gen.plans.plans;
const order = gen.plans.plan_order;
const contract = gen.contract;
/* Every data-bearing block below renders the generated showcase snapshot (apps/web/src/generated/showcase.json),
   refreshed on a schedule by scripts/refresh-showcase.mjs. Subjects are auto-selected on real coverage with
   men's divisions leading the primary composition; women's divisions stay on the card strip, rankings and docs. */
const fresh = freshness(show.generated_at);
const counts = show.counts;
const reg = show.registry;
const event = show.event;
const mainBout = event.bouts.reduce((m: any, b: any) => (b.bout_order > m.bout_order ? b : m), event.bouts[0]);
const HA = mainBout.fighter_a, HB = mainBout.fighter_b;
const fighterShow = show.fighter;
const flagship = show.matchup;
const FA = flagship.fighters[0], FB = flagship.fighters[1];
const mw = show.rankings;
const womens = show.womens;
const rec = show.provenance;
/* Cross-links to the production application. Resolved and liveness-checked at refresh time by
   scripts/refresh-showcase.mjs, so no slug is hard-coded here and a deep link is only rendered when
   that page exists; otherwise it falls back to the consumer site's section index. */
const links = show.product_links;
const videos = (show as any).videos ?? null;
const pbeFighter = links.fighter || links.fighters_index;
const pbeMatchup = links.matchup || links.fight_week;
const pbeEvent = links.fight_week;

const EVENT_ID = event.event.id, SHOW_FIGHTER = fighterShow.fighter.id, FA_ID = FA.id, FB_ID = FB.id;
/* Fight-week state (API 2026-09-11.1), generated by the same refresh for the same event the card demo renders.
   Any block the API could not serve is null, and the page says so instead of inventing a value. */
const fw = (show as any).fight_week ?? null;
const fwSame = fw && fw.event?.id === EVENT_ID;
const wi = fwSame ? fw.weigh_ins : null;
const cc = fwSame ? fw.card_changes : null;
const fstat = fwSame ? fw.fighter_status : null;
const ledger = fwSame ? fw.ledger : null;
const intel = fwSame ? fw.intelligence : null;
const avail = fw ? fw.availability : null;
const chain = wi?.chain ?? null;
/* a ledger diff small enough to read in one line; large first-capture diffs are left to the JSON */
const cleanDiff = ledger?.diffs?.find((d: any) => d.changed_count > 0 && d.changed_count <= 6 && d.changes?.length) ?? null;
const unnamed = avail?.rows?.find((r: any) => r.status_type === "injury" && !r.injury_type) ?? null;
const named = avail?.rows?.find((r: any) => r.injury_type && r.clinical_quote) ?? null;
const fmtVal = (v: any) => (v === null || v === undefined ? "null" : typeof v === "string" ? `"${v}"` : String(v));
const wiSource = wi?.readings?.[0] ? `${wi.readings[0].source_name} (${wi.readings[0].source_kind})` : null;
const checkpointLabel = (k: string) => k.replace("t_minus_", "T-").replace(/_/g, " ");
const fam = (k: string) => (reg?.families?.[k] || []);
const famCard = (t: string, k: string, blurb: string, picks: [string, string][]) => ({ t, blurb, keys: fam(k).map((m: any) => m.metric_key), picks });
const families = [
  famCard("Stance DNA", "stance", "Record, finish and strike differential split by the opponent's listed stance, plus open- and same-stance context.", [["stance_record", "W/L/D vs each stance"], ["stance_finish_rate", "Finishes vs that stance"], ["open_stance_record", "Orthodox vs southpaw"]]),
  famCard("Striking DNA", "striking", "Pace, accuracy and defense per observed minute; head, body and leg target shares; distance, clinch and ground phase shares.", [["sig_landed_per_min", "Sig. strikes landed / min"], ["sig_accuracy", "Strike accuracy"], ["head_attack_share", "Head target share"]]),
  famCard("Grappling DNA", "grappling", "Takedown volume and accuracy per 15 observed minutes, control seconds per takedown, control share, submission attempts.", [["td_attempts_per_15", "Takedown attempts / 15"], ["td_accuracy", "Takedown accuracy"], ["control_seconds_per_td", "Control seconds / TD"]]),
  famCard("Finish DNA", "finish", "How and when finishes happen: finish, KO and submission rates, finish-round distribution, median finish time.", [["finish_rate", "Finish rate of wins"], ["ko_finish_rate", "KO/TKO finish rate"], ["finish_round_distribution", "Finish round spread"]]),
  famCard("Round DNA", "pace", "Whether round-one pace survives into rounds two and three, championship-round delta, defensive drift.", [["pace_retention_r3_vs_r1", "Pace retention R3/R1"], ["championship_round_delta", "Championship-round delta"], ["defensive_drift_r3_vs_r1", "Defensive drift"]]),
  famCard("Context DNA", "context", "Records under specific conditions: short notice, three- and five-round bouts, title fights, main events.", [["five_round_record", "Five-round record"], ["title_bout_record", "Title-bout record"], ["short_notice_record", "Short-notice record"]]),
];
const metricCount = Object.values(reg?.families || {}).reduce((n: number, f: any) => n + f.length, 0);
const divisionOf = (f: any) => { const p = (f.ranking?.positions || []).filter((x: any) => !x.is_p4p)[0]; return p ? p.label : null; };
const jsonLd = [
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": "https://ufc.proptechusa.ai/#app", name: "PropTechUSA UFC Intelligence API", applicationCategory: "DeveloperApplication", operatingSystem: "Any", url: "https://ufc.proptechusa.ai", description: "Developer-ready UFC event, fighter, fight-card and round-level data, official weigh-ins, availability and card changes with full history, plus proprietary PropBetEdge Fight DNA and matchup intelligence.", softwareVersion: contract.api_version, publisher: { "@id": "https://proptechusa.ai/#organization" }, offers: { "@type": "AggregateOffer", priceCurrency: "USD", lowPrice: 79, highPrice: 1499, offerCount: 4, url: "https://ufc.proptechusa.ai/pricing" } },
  { "@context": "https://schema.org", "@type": "Product", "@id": "https://ufc.proptechusa.ai/#product", name: "PropTechUSA UFC Intelligence API", description: "Normalized UFC data plus proprietary PropBetEdge Fight DNA and Matchup DNA, delivered through one developer API.", brand: { "@type": "Brand", name: "PropTechUSA" }, image: "https://ufc.proptechusa.ai/brand/og-ufc-api-v2-1200x630.png", offers: order.filter((k) => plans[k as keyof typeof plans].price_usd_month !== null).map((k) => ({ "@type": "Offer", name: `${plans[k as keyof typeof plans].name} plan`, price: plans[k as keyof typeof plans].price_usd_month, priceCurrency: "USD", availability: "https://schema.org/InStock", url: `https://ufc.proptechusa.ai/pricing#plan-${k}` })) },
];
---
<Base title="UFC Intelligence API | Fight Data, Fight DNA & MMA Analytics" description="UFC data infrastructure for developers: normalized fighters, events, bouts and round statistics, official weigh-ins, availability and card changes with full history, plus Fight DNA and matchup analytics." path="/" jsonLd={jsonLd}>
  <!-- 1. HERO -->
  <section class="hero-v2">
    <div class="hero-fence" aria-hidden="true"></div>
    <div class="wrap">
      <div>
        <p class="eyebrow">PropTechUSA sports data · UFC Intelligence API</p>
        <h1>Build the fight product.<br /><span class="gold-em">Not the data pipeline.</span></h1>
        <p class="lede">UFC data infrastructure for developers — not another odds feed. Every fighter, card and round, normalized. Official weigh-ins, availability and card changes preserved as fight week moves. Plus proprietary PropBetEdge Fight DNA and Matchup DNA.</p>
        <div class="actions">
          <a class="btn primary" href="/pricing">Get API access</a>
          <a class="btn secondary" href="/workspace">Open Workspace</a>
          <a class="btn ghost" href={links.site} rel="noopener">See it in production →</a>
        </div>
        <p class="hero-sub-links"><a href="/docs">View docs →</a><span aria-hidden="true">·</span><a href={links.site} rel="noopener">PropBetEdge UFC is built on the same UFC intelligence layer</a></p>
        <div class="statstrip">
          <div><b>{fmtNumber(counts.events)}</b><span>Events</span></div>
          <div><b>{fmtNumber(counts.fighters)}</b><span>Fighters</span></div>
          <div><b>{fmtNumber(counts.bouts)}</b><span>Bouts</span></div>
          <div><b>{fmtNumber(counts.round_stat_rows)}</b><span>Rounds of stats</span></div>
          <div class="accent"><b>Fight DNA v{contract.fight_dna_definition_version}</b><span>Derived intelligence</span></div>
        </div>
      </div>
      <div>
        <FightPoster a={HA} b={HB} eventName={event.event.name} eventDate={event.event.event_date} venue={event.event.venue} city={event.event.city} region={event.event.region} tall
          label={`Main event · ${mainBout.weight_class.replace(/_/g, " ").toLowerCase()} · ${mainBout.scheduled_rounds} rounds`} badge="Fight week" meta={`${event.bout_count} bouts · ${event.event.card_status}`}
          endpoints={[{ path: `/v1/ufc/events/${"{id}"}/card` }, { path: `/v1/ufc/fighters/${"{id}"}` }, { path: `/v1/ufc/matchups/${"{a}"}/${"{b}"}/dna` }]}
          status={{ code: 200, ms: 42, plan: "Ultra" }} />
      </div>
    </div>
  </section>

  <!-- 2. FIGHTER PROFILE -->
  <section class="section band-deep" id="fighter-profile">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Fighter API</p><h2>A complete fighter page,<br /><span class="gold-em">from four calls.</span></h2><p class="lede">Identity, record, ranking, rights-cleared media, career stats and proprietary Fight DNA.</p></div>
        <a class="btn secondary" href={`/workspace?tool=fighter&id=${SHOW_FIGHTER}`}>Build this profile →</a>
      </div>
      <Demo eyebrow={`${divisionOf(fighterShow.fighter) || "Fighter"}${(fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0]?.rank === 0 ? " champion" : (fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0] ? " #" + (fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0].rank : ""} · selected on live coverage`} title={fighterShow.fighter.name} intro={`${fighterShow.fighter.record_w}-${fighterShow.fighter.record_l} · ${fighterShow.dna.sample_stat_bouts} stat-covered bouts · ${fighterShow.dna.sample_rounds} rounds · ${fmtNumber(fighterShow.dna.sample_seconds / 60, 0)} observed minutes`} captured={fresh.capturedAt}
        endpoints={[{ path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/history", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/stats", plan: "pro" }, { path: "/v1/ufc/fighters/{id}/dna", plan: "pro" }]}
        workspace={`/workspace?tool=fighter&id=${SHOW_FIGHTER}`} json={fighterShow.raw} jsonPath={fighterShow.paths.detail} jsonNote="subset: images[] and history[] shortened" pbe={pbeFighter} pbeLabel={links.fighter ? "View " + fighterShow.fighter.name + " on PropBetEdge UFC →" : "View fighters on PropBetEdge UFC →"}>
        <FighterPreview fighter={fighterShow.fighter} size="hero" showCareer />
        <div style="height:16px"></div>
        <FightDnaPreview snapshot={fighterShow.dna} title="Fight DNA" keys={["sig_landed_per_min", "sig_accuracy", "sig_defense", "knockdowns_per_15", "td_attempts_per_15", "pace_retention_r3_vs_r1"]} />
        <div slot="aside" class="powered">
          <p class="eyebrow">Recent bouts <span class="chip source">Source</span></p>
          <ul class="hist-list">{fighterShow.history.slice(0, 5).map((h: any) => <li><span class:list={["outcome", h.outcome || "none"]}>{h.outcome || "—"}</span><span><b>{h.opponent?.name || "TBA"}</b><br /><span class="small muted">{h.event?.name}</span></span><span class="small muted">{h.result?.method || "scheduled"}</span></li>)}</ul>
        </div>
      </Demo>
    </div>
  </section>

  <!-- 3. FIGHT WEEK -->
  <section class="section" id="fight-week">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Fight Week API</p><h2>The full fight-week state,<br /><span class="gold-em">through one API.</span></h2><p class="lede">Cards change. Fighters miss weight. Availability changes. Official sources confirm earlier reports. Video drops. Matchup context evolves. PropTechUSA UFC turns those moving pieces into one normalized developer contract.</p></div>
        <a class="btn secondary" href="/workspace?tool=card">Open in Workspace →</a>
      </div>
      <Demo eyebrow={`Current card · weigh-ins ${wi?.coverage?.state ?? "not yet covered"}`} title="The next card, through fight week" intro="Card, official weigh-ins, card changes, fighter status, video and the Fight State Ledger, all keyed to the same event, bout and fighter ids." captured={fresh.capturedAt}
        endpoints={[{ path: "/v1/ufc/events/{id}/card", plan: "developer" }, { path: "/v1/ufc/events/{id}/weigh-ins", plan: "developer" }, { path: "/v1/ufc/events/{id}/card-changes", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/status", plan: "developer" }, { path: "/v1/ufc/events/{id}/videos", plan: "developer" }, { path: "/v1/ufc/events/{id}/intelligence", plan: "ultra" }, { path: "/v1/ufc/bouts/{id}/ledger", plan: "ultra" }]}
        workspace="/workspace?tool=card" json={event.raw} jsonPath={event.path} jsonNote="subset: 2 of 13 bouts, images[] omitted" pbe={links.weigh_ins || pbeEvent} pbeLabel={links.weigh_ins ? "See the weigh-in desk on PropBetEdge UFC →" : "See this card on PropBetEdge UFC Fight Week →"}>
        <EventCardPreview event={event} limit={12} />
        <div slot="aside" class="fw-aside">
          {wi ? (
            <div class="powered">
              <WeighInPreview coverage={wi.coverage} readings={wi.readings} limit={4} source={wiSource} />
              <div class="actions-row" style="margin-top:12px"><JsonDrawer json={wi.raw} path={wi.path} title="Event weigh-ins response" note="subset: 1 current reading and the 2 history rows behind it" label="View JSON →" /></div>
            </div>
          ) : (
            <div class="powered"><p class="eyebrow">Official weigh-ins</p><p class="small muted" style="margin:0">Weigh-in coverage for this card was not available at the last refresh. The endpoint answers with an explicit coverage state rather than an empty guess.</p></div>
          )}
          <div class="powered fw-state">
            <div class="fw-line">
              <span class="k">Card changes</span>
              <b>{cc ? cc.count : "—"}</b>
              <span class="d">{cc ? (cc.count ? `${cc.changes[0].status_type.replace(/_/g, " ")}: ${cc.changes[0].fighter_name} (${cc.changes[0].source_name})` : "Nothing has changed on this card. An empty array is the normal state, not an error.") : "Not available at the last refresh."}</span>
            </div>
            {fstat && (
              <div class="fw-line">
                <span class="k">{fstat.fighter.name} · status</span>
                <b>{fstat.current ? fstat.current.status_type.replace(/_/g, " ") : "null"}</b>
                <span class="d">{fstat.current ? `${fstat.current.status_detail || ""} (${fstat.current.source_name})` : "No availability event on file. That is the absence of a report, not a claim of fitness."}</span>
              </div>
            )}
            {ledger && (
              <div class="fw-line">
                <span class="k">Ledger · {ledger.bout.fighter_a} vs {ledger.bout.fighter_b} <span class="chip plan-ultra">Ultra</span></span>
                <b>{ledger.total}</b>
                <span class="d">append-only snapshots{cleanDiff ? <> · latest diff <code>{cleanDiff.changes[0].path}</code> {fmtVal(cleanDiff.changes[0].from)} → {fmtVal(cleanDiff.changes[0].to)}</> : ""}</span>
              </div>
            )}
          </div>
        </div>
      </Demo>

      {womens.matchup ? (
        <div class="fw-womens">
          <p class="eyebrow">{womens.matchup.label} · {womens.matchup.weight_class.replace(/_/g, " ").toLowerCase()} <span class="chip derived">PBE derived</span></p>
          <p><b>{womens.matchup.fighters[0].name} vs {womens.matchup.fighters[1].name}</b> — every division on this card resolves through the same endpoints, weigh-ins and ledger included.</p>
          <ul>{womens.matchup.insights.slice(0, 2).map((i: any) => <li>{i.explanation}</li>)}</ul>
        </div>
      ) : (
        <div class="fw-womens"><p class="eyebrow">Every division</p><p>This card has no women's bout scheduled. Every division resolves through the same endpoints; see the <a href="/workspace?tool=rankings">Workspace rankings tool</a>.</p></div>
      )}

      <div class="fw-grid">
        <div class="fw-tile">
          <div class="fw-tile-head"><span class="chip source">Source</span><span class="chip plan-developer">Developer+</span></div>
          <h3>Official Weigh-Ins</h3>
          <p>Current readings, source history, confirmations, corrections and explicit unpublished limits.</p>
          <div class="fw-proof">{wi && wi.coverage?.state !== "no_data" ? <><b>{wi.coverage.weighed}/{wi.coverage.expected}</b> weighed · <b>{wi.coverage.confirmations}</b> confirmed · <b>{wi.coverage.corrections}</b> corrected · <b>{wi.history_count}</b> stored readings</> : "coverage.state reports live, final or no_data for every card"}</div>
          <code class="fw-ep">GET /v1/ufc/events/{"{id}"}/weigh-ins?include=history</code>
          <div class="fw-links"><a href="/docs#weigh-ins">Docs →</a>{links.weigh_ins && <a href={links.weigh_ins} rel="noopener">PropBetEdge weigh-in desk →</a>}</div>
        </div>
        <div class="fw-tile">
          <div class="fw-tile-head"><span class="chip source">Source</span><span class="chip plan-developer">Developer+</span></div>
          <h3>Availability &amp; Card Changes</h3>
          <p>Injuries, withdrawals, fighter status and event-card changes without inferred diagnoses.</p>
          <div class="fw-proof">{avail ? <><b>{avail.total}</b> active availability events · <b>{cc ? cc.count : "—"}</b> changes on this card · cause named by the source on <b>{avail.with_named_injury}</b></> : "every row is individually sourced"}</div>
          <code class="fw-ep">GET /v1/ufc/injuries · /events/{"{id}"}/card-changes · /fighters/{"{id}"}/status</code>
          <div class="fw-links"><a href="/docs#availability">Docs →</a>{links.injuries && <a href={links.injuries} rel="noopener">PropBetEdge injuries →</a>}</div>
        </div>
        <div class="fw-tile">
          <div class="fw-tile-head"><span class="chip derived">PBE derived</span><span class="chip plan-ultra">Ultra+</span></div>
          <h3>Fight State Ledger</h3>
          <p>Append-only checkpoints that preserve what changed rather than overwriting history.</p>
          <div class="fw-proof">{ledger ? <><b>{ledger.total}</b> snapshots for {ledger.bout.fighter_a} vs {ledger.bout.fighter_b} · checkpoints {Object.keys(ledger.checkpoints || {}).map(checkpointLabel).join(", ")}</> : "deterministic diffs between checkpoints"}</div>
          <code class="fw-ep">GET /v1/ufc/bouts/{"{id}"}/ledger</code>
          <div class="fw-links"><a href="/docs#ledger">Docs →</a></div>
        </div>
        <div class="fw-tile">
          <div class="fw-tile-head"><span class="chip derived">PBE derived</span><span class="chip plan-ultra">Ultra+</span></div>
          <h3>Event Intelligence</h3>
          <p>Per-bout fight state for the whole card (Fight DNA readiness, ledger checkpoints and diffs) on the same event and bout ids as weigh-ins, availability and video.</p>
          <div class="fw-proof">{intel ? <><b>{intel.bouts}</b> bouts · <b>{intel.snapshots}</b> ledger snapshots · Fight DNA ready on <b>{intel.dna_ready}</b> of {intel.bouts}{intel.unavailable_sources?.length ? <> · sources not yet in the ledger are named: {intel.unavailable_sources.join(", ")}</> : ""}</> : "one call for the whole card"}</div>
          <code class="fw-ep">GET /v1/ufc/events/{"{id}"}/intelligence</code>
          <div class="fw-links"><a href="/docs#ledger">Docs →</a><a href={pbeEvent} rel="noopener">PropBetEdge Fight Week →</a></div>
        </div>
        <div class="fw-tile">
          <div class="fw-tile-head"><span class="chip link">Third-party link</span><span class="chip plan-developer">Developer+</span></div>
          <h3>Official Video</h3>
          <p>Event, fighter and bout video attached to the same entity graph.</p>
          <div class="fw-proof">{videos?.counts ? <><b>{videos.counts.current_event}</b> clips linked to this card · lead slot: {videos.featured?.video_type_label || videos.featured?.video_type?.replace(/_/g, " ") || "—"} · metadata and links only</> : "metadata and official links, nothing rehosted"}</div>
          <code class="fw-ep">GET /v1/ufc/events/{"{id}"}/videos</code>
          <div class="fw-links"><a href="#video">Video desk ↓</a><a href="/docs#videos">Docs →</a></div>
        </div>
        <div class="fw-tile premium">
          <div class="fw-tile-head"><span class="chip derived">PBE derived</span><span class="chip plan-pro">Pro+</span></div>
          <h3>Fight DNA</h3>
          <p>Stance, striking, grappling, finish, round and context DNA: proprietary, as-of versioned, and computed from the same fight graph.</p>
          <div class="fw-proof"><b>{metricCount}</b> versioned metrics · definition v{contract.fight_dna_definition_version} · every value with sample, confidence and as-of date</div>
          <code class="fw-ep">GET /v1/ufc/fighters/{"{id}"}/dna · /matchups/{"{a}"}/{"{b}"}/dna</code>
          <div class="fw-links"><a href="#fight-dna">Fight DNA ↓</a><a href="/learn/fight-dna">Methodology →</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3b. DEVELOPER TRUST: CHANGE HISTORY -->
  <section class="section band-deep" id="history">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Developer trust</p><h2>The data doesn't forget<br /><span class="gold-em">what changed.</span></h2><p class="lede">Fight week is a stream of revisions. The API keeps every revision, labels it, and never fills a gap with a guess.</p></div>
        <a class="btn secondary" href="/docs#weigh-ins">How history works →</a>
      </div>
      <div class="trust">
        <div class="trust-list">
          <div class="trust-item">
            <b>Corrections are retained, not overwritten</b>
            <p>A new reading points at the one it replaced with <code>supersedes_id</code>. The replaced row stays queryable under <code>?include=history</code>, so you can always show what a number used to be.</p>
            {wi && <span class="ev">{wi.history_count} stored readings behind {wi.current_count} current ones</span>}
          </div>
          <div class="trust-item">
            <b>Confirmation is not correction</b>
            <p>If an official source repeats the same weight, that is <code>is_confirmation</code>. Only a changed weight is <code>is_correction</code>. The two are counted separately, so an official re-publish never looks like a revision.</p>
            {wi && <span class="ev">confirmations: {wi.coverage.confirmations} · corrections: {wi.coverage.corrections}</span>}
          </div>
          <div class="trust-item">
            <b>Unpublished values stay null</b>
            <p>An unpublished contracted limit is <code>null</code> with a <code>limit_basis</code>, never the division default. An unnamed injury is <code>injury_type: null</code>. With no report on file, a fighter's status is <code>current: null</code>, which is not a claim they are fit.</p>
            {unnamed && <span class="ev">{unnamed.fighter_name} · {unnamed.status_type} · injury_type: null</span>}
          </div>
          <div class="trust-item">
            <b>Derived intelligence is labeled</b>
            <p>Fight DNA, Matchup DNA and ledger diffs are <code>PBE_DERIVED</code>. Every metric carries its sample, confidence, as-of date and definition version. Source facts are <code>SOURCE_FACT</code>. Every operation in the contract declares its origin.</p>
            <span class="ev">origin: PBE_DERIVED · definition_version: {contract.fight_dna_definition_version}</span>
          </div>
          <div class="trust-item">
            <b>External reporting keeps its provenance</b>
            <p>Every weigh-in and availability row carries <code>source_name</code>, <code>source_kind</code> and <code>source_url</code>. Official sources outrank news, and a named injury ships with the sentence that licensed it.</p>
            {named && <span class="ev">{named.fighter_name} · {named.source_name} ({named.source_kind}) · clinical_quote attached</span>}
          </div>
          <div class="trust-item">
            <b>The contract is versioned</b>
            <p>Every response carries <code>X-API-Version</code>. Fight DNA definitions are versioned separately. Since 2026-09-06 changes have been additive only, and the commercial OpenAPI is generated from the canonical contract, never hand-edited.</p>
            <span class="ev">X-API-Version: {contract.api_version} · Fight DNA v{contract.fight_dna_definition_version}</span>
          </div>
        </div>
        {chain ? (
          <div class="receipt-card trust-card">
            <p class="who">{event.event.name} · weigh-in history</p>
            <SupersessionChain chain={chain} />
            {cleanDiff && (
              <div class="trust-ledger">
                <span class="k">Fight State Ledger · {ledger.bout.fighter_a} vs {ledger.bout.fighter_b}</span>
                <code>{checkpointLabel(cleanDiff.older)} → {checkpointLabel(cleanDiff.newer)} · {cleanDiff.changes[0].path}: {fmtVal(cleanDiff.changes[0].from)} → {fmtVal(cleanDiff.changes[0].to)}</code>
              </div>
            )}
            <div class="actions-row" style="margin-top:16px"><JsonDrawer json={wi.raw} path={wi.path} title="Event weigh-ins with history" note="subset: the current reading and the stored row it superseded" label="View the rows →" /></div>
          </div>
        ) : (
          <div class="receipt-card trust-card">
            <p class="who">Weigh-in history</p>
            <p class="small" style="color:var(--dim)">The current card has no superseded reading yet. When a second source reports the same fighter, both rows are kept and the newer one is marked as a confirmation or a correction.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 4. MATCHUP DNA -->
  <section class="section band-gold" id="matchup-dna">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Matchup DNA API <span class="chip plan-ultra">Ultra</span></p><h2>Two fighters in.<br /><span class="gold-em">Matchup intelligence out.</span></h2><p class="lede">Each fighter measured against the opponent actually in front of them. Insights fire only above documented thresholds; everything else is a named warning.</p></div>
        <a class="btn secondary" href={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`}>Open in Workspace →</a>
      </div>
      <Demo eyebrow={`${flagship.weight_class ? flagship.weight_class.replace(/_/g, " ").toLowerCase() : "matchup"} · ${flagship.label}${flagship.on_current_card ? " · on the current card" : ""}`} title={`${FA.name} vs ${FB.name}`} intro={`${flagship.meta.comparable} of ${flagship.meta.comparisons} metrics comparable · ${flagship.insights.length} insights above threshold · stance context ${flagship.stance_context.context.replace(/_/g, " ")}`} captured={fresh.capturedAt} single
        endpoints={[{ path: "/v1/ufc/matchups/{a}/{b}/dna", plan: "ultra" }, { path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/splits", plan: "pro" }]}
        workspace={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`} json={flagship.raw} jsonPath={flagship.path} jsonNote="subset: 3 of 18 comparisons, 2 of 12 insights" pbe={pbeMatchup} pbeLabel={links.matchup ? "View this matchup on PropBetEdge UFC →" : "See Fight Week on PropBetEdge UFC →"}>
        <MatchupPreview matchup={flagship} />
      </Demo>
    </div>
  </section>

  <!-- 5. RANKINGS -->
  <section class="section" id="rankings">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Rankings API · {mw.division.label}</p><h2>Champion, top 15, movement.</h2><p class="lede">The verified ufc.com snapshot, linked to canonical fighter ids so every row opens a profile, Fight DNA or a matchup. Portraits come from one bulk media call. Every men's and women's division resolves the same way.</p></div>
        <a class="btn secondary" href={`/workspace?tool=rankings&division=${mw.division.key}`}>Open in Workspace →</a>
      </div>
      <div class="demo">
        <div class="demo-body">
          <RankingsPreview rankings={mw} limit={8} />
          <div class="powered">
            <p class="eyebrow">Powered by</p>
            <ul>
              <li><span class="m">GET</span><span>{mw.path.replace("/v1/ufc", "")}</span><span class="chip plan-developer">Developer+</span></li>
              <li><span class="m">GET</span><span>/v1/ufc/fighters/media?ids=…</span><span class="chip plan-developer">Developer+</span></li>
              <li><span class="m">GET</span><span>/v1/ufc/fighters/{"{id}"}?include=ranking</span><span class="chip plan-developer">Developer+</span></li>
            </ul>
            <div class="actions-row">
              <a class="btn secondary" href={`/workspace?tool=rankings&division=${mw.division.key}`}>Open in Workspace →</a>
              <JsonDrawer json={mw.raw} path={mw.path} title="Rankings response" note="subset: 3 entries" label="View JSON →" />
            </div>
            <a class="pbe-link" href={links.rankings} rel="noopener"><span class="m">PropBetEdge UFC</span> View the live rankings product →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5b. PRODUCT PROOF -->
  <section class="section band-gold" id="production">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow gold">Product proof</p>
          <h2>The engine behind <span class="gold-em">a real UFC product.</span></h2>
          <p class="lede">PropBetEdge UFC is a production fight-intelligence application built on the same underlying UFC data and Fight DNA layer this API exposes. These are its four core surfaces, composed here from the same snapshot the demos above render.</p>
        </div>
        <a class="btn gold" href={links.site} rel="noopener">Explore PropBetEdge UFC →</a>
      </div>

      <div class="proof-grid">
        <a class="shot" href={pbeEvent} rel="noopener">
          <div class="shot-bar"><span class="dot" aria-hidden="true"></span><span class="url">ufc.propbetedge.ai/fight-week</span></div>
          <div class="shot-body">
            <p class="shot-kicker">Fight Week</p>
            <p class="shot-title">{event.event.name}</p>
            <p class="shot-meta">{fmtDate(event.event.event_date)} · {event.bout_count} bouts · {event.event.city}{event.event.country ? ", " + event.event.country : ""}</p>
            <div class="shot-faces">
              {event.bouts.flatMap((b: any) => [b.fighter_a, b.fighter_b]).filter((f: any) => f?.primary_image?.thumb_url).slice(0, 6).map((f: any) => (
                <span class="face"><img src={f.primary_image.thumb_url} alt="" width="72" height="72" loading="lazy" decoding="async" /></span>
              ))}
            </div>
          </div>
          <span class="shot-cta">View on PropBetEdge UFC →</span>
        </a>

        <a class="shot" href={pbeFighter} rel="noopener">
          <div class="shot-bar"><span class="dot" aria-hidden="true"></span><span class="url">ufc.propbetedge.ai/fighters</span></div>
          <div class="shot-body fighter-shot">
            {fighterShow.fighter.primary_image?.card_url && <img class="shot-portrait" src={fighterShow.fighter.primary_image.card_url} alt="" width="220" height="275" loading="lazy" decoding="async" />}
            <div>
              <p class="shot-kicker">Fighter profile</p>
              <p class="shot-title">{fighterShow.fighter.name}</p>
              <p class="shot-meta">{fighterShow.fighter.record_w}-{fighterShow.fighter.record_l}{fighterShow.fighter.record_d ? "-" + fighterShow.fighter.record_d : ""} · {fighterShow.dna.sample_stat_bouts} stat-covered bouts</p>
              <div class="shot-bars">
                {/* first three metrics this fighter actually has coverage for; a zero would read as a broken cell */}
                {["sig_landed_per_min", "sig_accuracy", "sig_defense", "td_landed_per_15", "control_share", "finish_rate", "knockdowns_per_15"]
                  .map((k) => ({ k, m: (fighterShow.dna as any)?.metrics?.[k] }))
                  .filter((x: any) => x.m && x.m.value !== null && x.m.value !== undefined && x.m.value !== 0)
                  .slice(0, 3)
                  .map((x: any) => <div class="shot-bar-row"><span>{x.k.replace(/_/g, " ")}</span><b>{fmtNumber(x.m.value, 2)}</b></div>)}
              </div>
            </div>
          </div>
          <span class="shot-cta">View on PropBetEdge UFC →</span>
        </a>

        <a class="shot" href={pbeMatchup} rel="noopener">
          <div class="shot-bar"><span class="dot" aria-hidden="true"></span><span class="url">ufc.propbetedge.ai/fights</span></div>
          <div class="shot-body">
            <p class="shot-kicker">Matchup DNA</p>
            <p class="shot-title">{FA.name} <span class="vs-mini">vs</span> {FB.name}</p>
            <p class="shot-meta">{flagship.meta.comparable} of {flagship.meta.comparisons} metrics comparable · {flagship.insights.length} insights</p>
            <div class="shot-bars">
              {flagship.comparisons.filter((c: any) => c.comparable).slice(0, 3).map((c: any) => (
                <div class="shot-bar-row"><span>{c.label}</span><b>{fmtNumber(c.a?.value, 2)} / {fmtNumber(c.b?.value, 2)}</b></div>
              ))}
            </div>
          </div>
          <span class="shot-cta">View on PropBetEdge UFC →</span>
        </a>

        <a class="shot" href={links.rankings} rel="noopener">
          <div class="shot-bar"><span class="dot" aria-hidden="true"></span><span class="url">ufc.propbetedge.ai/rankings</span></div>
          <div class="shot-body">
            <p class="shot-kicker">Rankings</p>
            <p class="shot-title">{mw.division.label}</p>
            <p class="shot-meta">{mw.source} snapshot {fmtDate(mw.snapshot_date)}</p>
            <div class="shot-rank">
              {mw.division.champion && <div class="shot-rank-row champ"><span class="r">C</span><span class="n">{mw.division.champion.name}</span></div>}
              {mw.division.entries.slice(0, 4).map((e: any) => <div class="shot-rank-row"><span class="r">{e.rank}</span><span class="n">{e.name}</span></div>)}
            </div>
          </div>
          <span class="shot-cta">View on PropBetEdge UFC →</span>
        </a>
      </div>

      <p class="small muted" style="margin-top:18px">Built on the same UFC intelligence layer. PropBetEdge UFC is a PropTechUSA network product; surfaces shown here are its own application features, not a claim that every element is served by the commercial API.</p>
    </div>
  </section>

  <!-- 5c. FIGHT WEEK VIDEO -->
  {videos?.featured && (
  <section class="section" id="video">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow gold">Fight week video</p>
          <h2>The week, <span class="gold-em">on camera.</span></h2>
          <p class="lede">Official fight-week video metadata surfaced through the UFC Intelligence API. Clips are selected by the same policy the consumer product uses: current-event relevance first, then English, embeddable, official channel tier, freshness and clip type. The lead slot shifts through the week from preview to media day to weigh-in to post-fight.</p>
        </div>
        <a class="btn secondary" href="/workspace?tool=videos">Open in Workspace →</a>
      </div>
      <VideoDesk videos={videos} productLink={links.fight_week} />
      <div class="powered" style="margin-top:18px">
        <p class="eyebrow">Powered by</p>
        <ul>
          <li><span class="m">GET</span><span>/v1/ufc/videos?event_id={"{id}"}</span><span class="chip plan-developer">Developer+</span></li>
          <li><span class="m">GET</span><span>/v1/ufc/events/{"{id}"}/videos</span><span class="chip plan-developer">Developer+</span></li>
          <li><span class="m">GET</span><span>/v1/ufc/fighters/{"{id}"}/videos</span><span class="chip plan-developer">Developer+</span></li>
        </ul>
        <div class="actions-row">
          <a class="btn secondary" href="/docs#videos">Video API docs →</a>
          <JsonDrawer json={videos.raw} path={videos.path} title="Videos response" note="subset: 2 of the returned rows" label="View JSON →" />
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- 6. FIGHT DNA -->
  <section class="section band-deep" id="fight-dna">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Proprietary intelligence</p><h2>Raw stats tell you what happened.<br /><span class="gold-em">Fight DNA shows the pattern.</span></h2><p class="lede">Event-dated bout and round history rebuilt into as-of fighter intelligence: stance matchups, striking, grappling, finishing, round progression and context. Six families, {metricCount} versioned metrics.</p></div>
        <a class="btn secondary" href="/learn/fight-dna">Methodology →</a>
      </div>
      <div class="dna-grid">
        {families.map((f) => (
          <div class="dna">
            <h3>{f.t}</h3>
            <p>{f.blurb}</p>
            <div class="metricline">{f.picks.filter(([k]) => f.keys.includes(k)).map(([k, label]) => <div><span>{label}</span><b>{f.keys.includes(k) ? "✓" : "—"}</b></div>)}</div>
            <div class="keys">{f.keys.length} metrics · {f.keys.slice(0, 4).join(" · ")}{f.keys.length > 4 ? " …" : ""}</div>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:18px">Every value carries its sample, confidence, coverage, source families, as-of date and definition version. Derived by PropBetEdge; never presented as official UFC statistics.</p>
    </div>
  </section>

  <!-- 7. RECEIPTS -->
  <section class="section" id="receipts">
    <div class="wrap">
      <p class="eyebrow">Provenance</p>
      <h2>Every number has receipts.</h2>
      <div class="receipt" style="margin-top:26px">
        {rec && <ReceiptPreview fighter={rec.fighter} metric={rec.metric} />}
        <div>
          <p class="lede">This is a verbatim <code>MetricObject</code> from the live API, not a marketing number. A low sample is reported as a low sample. A zero denominator is a <code>null</code> with <code>confidence: "insufficient"</code>, never a fake zero.</p>
          <ApiRequest path={fighterShow.paths.dna} plan="pro" compact />
          <div class="actions-row" style="margin-top:14px">
            <JsonDrawer json={fighterShow.raw_dna} path={fighterShow.paths.dna} title="Fighter Fight DNA response" note={`captured ${fresh.capturedAt} · subset`} label="View full response →" />
            <a class="btn ghost" href="/learn/fight-dna#provenance">How confidence is computed →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. WORKSPACE -->
  <section class="section band-deep" id="workspace">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Developer Workspace</p><h2>Buy a key. Run the current card in 30 seconds.</h2><p class="lede">Search fighters by name, run Fight DNA and Matchup DNA, render cards and rankings, then copy the exact cURL, JavaScript or Python that reproduces the call.</p></div>
        <a class="btn primary" href="/workspace">Open Workspace →</a>
      </div>
      <div class="build-grid">
        {[
          ["Current Fight Week", "One click: the next event, its full card, official weigh-ins and card changes.", "/v1/ufc/events/{id}/card · /weigh-ins · /card-changes", "developer", "/workspace?tool=card"],
          ["Explore a fighter", "Search by name, then Overview, History, Stats, Fight DNA and Media tabs.", "/v1/ufc/fighters/{id}…", "developer", `/workspace?tool=fighter&id=${SHOW_FIGHTER}`],
          ["Compare fighters", "Pick two fighters and render the full matchup card with insights.", "/v1/ufc/matchups/{a}/{b}/dna", "ultra", `/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`],
          ["View rankings", "Champion and top 15 with portraits, in every division.", "/v1/ufc/rankings", "developer", `/workspace?tool=rankings&division=${mw.division.key}`],
          ["Test Fight DNA", "Snapshot, stance splits, round and finish profiles, with as-of dates.", "/v1/ufc/fighters/{id}/dna", "pro", `/workspace?tool=dna&id=${SHOW_FIGHTER}`],
          ["Any endpoint", "Request builder with rendered preview, JSON and code snippets.", "/v1/ufc/*", "developer", "/workspace?tool=custom"],
        ].map(([t, p, ep, plan, href]: any) => (
          <a class="build" href={href} style="text-decoration:none">
            <div class="section-head" style="margin:0"><h3 style="margin:0">{t}</h3><span class:list={["chip", `plan-${plan}`]}>{plans[plan as keyof typeof plans].name}+</span></div>
            <p>{p}</p>
            <div class="endpoints">GET {ep}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8b. PRICING TRANSITION -->
  <section class="transition">
    <div class="art" aria-hidden="true">
      <img src={FA.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
      <img src={FB.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="wrap">
      <p class="eyebrow plain" style="justify-content:center">Matchup DNA</p>
      <h2>Two fighters. One matchup.<br /><span class="gold-em">Sixty derived metrics. One API.</span></h2>
      <p class="lede center">{FA.name} versus {FB.name} resolves to {flagship.meta.comparable} comparable metrics and {flagship.insights.length} threshold-cleared reads, each with its own sample and confidence.</p>
      <div class="actions-row" style="justify-content:center">
        <a class="btn primary" href="/pricing">See plans</a>
        <a class="btn secondary" href={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`}>Run it in Workspace</a>
      </div>
      <p class="credit">{[FA.primary_image?.attribution_text, FB.primary_image?.attribution_text].filter(Boolean).join(" · ")}</p>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section class="section" id="plans">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Plans</p><h2>Not just UFC data.</h2><p class="lede">Every plan starts with normalized fight records, official weigh-ins and sourced availability. Pro unlocks fighter Fight DNA. Ultra unlocks Matchup DNA and the Fight State Ledger. Scale is production infrastructure.</p></div><a class="btn secondary" href="/pricing">Full pricing →</a></div>
      <div class="pricing-grid">
        {order.filter((k) => k !== "enterprise").map((k) => { const p = plans[k as keyof typeof plans] as any; return (
          <div class:list={["plan", { recommended: p.recommended }]}>
            {p.recommended && <span class="rec">Recommended</span>}
            <div class="tier">{p.name}</div>
            <div class="price">${p.price_usd_month}<small>/mo</small></div>
            <div class="pos">{p.tagline}</div>
            <div class="limits">{fmtNumber(p.included_requests)} req/mo<br />{p.rate_limit_per_min} req/min</div>
            <a class:list={["btn cta", p.recommended ? "gold" : "secondary"]} href={`/pricing#plan-${k}`}>{p.cta}</a>
          </div>
        ); })}
      </div>
    </div>
  </section>

  <!-- 10. FINAL -->
  <section class="final-cta transition">
    <div class="art" aria-hidden="true">
      <img src={fighterShow.fighter.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
      <img src={FB.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="wrap">
      <p class="eyebrow plain" style="justify-content:center">The engine behind a real UFC product</p>
      <h2>You've seen the API.<br /><span class="gold-em">Now see what it builds.</span></h2>
      <p class="lede center" style="margin:0 auto 26px">PropBetEdge UFC is a production fight-intelligence application built on the same UFC intelligence layer. Build yours on the same foundation.</p>
      <div class="actions-row" style="justify-content:center">
        <a class="btn gold" href={links.site} rel="noopener">Explore PropBetEdge UFC →</a>
        <a class="btn primary" href="/pricing">Get API access</a>
        <a class="btn secondary" href="/workspace">Open Workspace</a>
      </div>
      <p class="credit">{[fighterShow.fighter.primary_image?.attribution_text, FB.primary_image?.attribution_text].filter(Boolean).join(" · ")}</p>
    </div>
  </section>
</Base>
