---
import Base from "../layouts/Base.astro";
import ApiRequest from "../components/ApiRequest.astro";
import JsonDrawer from "../components/JsonDrawer.astro";
import Demo from "../components/Demo.astro";
import FighterPreview from "../components/FighterPreview.astro";
import FightDnaPreview from "../components/FightDnaPreview.astro";
import MatchupPreview from "../components/MatchupPreview.astro";
import EventCardPreview from "../components/EventCardPreview.astro";
import RankingsPreview from "../components/RankingsPreview.astro";
import ReceiptPreview from "../components/ReceiptPreview.astro";
import gen from "../generated/entitlements.json";
import ex from "../generated/examples.json";
import { fmtDate, fmtNumber } from "../lib/hl";

const plans = gen.plans.plans;
const order = gen.plans.plan_order;
const contract = gen.contract;
const counts = ex.counts_full;
const reg = ex.dna_registry;
const rec = ex.receipts;
const sc = ex.showcase;
const hero = sc.hero, silva = sc.fighter, matchup = sc.matchup, event = sc.event, fw = sc.rankings_featherweight;
const HERO_ID = hero.fighter.id, SILVA_ID = silva.fighter.id, DELGADO_ID = sc.opponent.fighter.id, EVENT_ID = event.event.id;
const fam = (k: string) => (reg?.families?.[k] || []).map((m: any) => m.metric_key);
const families = [
  { t: "Stance DNA", keys: fam("stance") }, { t: "Striking DNA", keys: fam("striking") }, { t: "Grappling DNA", keys: fam("grappling") },
  { t: "Finish DNA", keys: fam("finish") }, { t: "Round DNA", keys: fam("pace") }, { t: "Context DNA", keys: fam("context") },
];
const heroCoverage = `${hero.dna.sample_stat_bouts} stat-covered bouts · ${hero.dna.sample_rounds} rounds · ${fmtNumber(hero.dna.sample_seconds / 60, 0)} min observed`;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": "https://ufc.proptechusa.ai/#app", name: "PropTechUSA UFC Intelligence API", applicationCategory: "DeveloperApplication", operatingSystem: "Any", url: "https://ufc.proptechusa.ai", description: "Developer-ready UFC event, fighter, fight-card and round-level data with proprietary PropBetEdge Fight DNA and matchup intelligence.", softwareVersion: contract.api_version, publisher: { "@id": "https://proptechusa.ai/#organization" }, offers: { "@type": "AggregateOffer", priceCurrency: "USD", lowPrice: 79, highPrice: 1499, offerCount: 4, url: "https://ufc.proptechusa.ai/pricing" } },
  { "@context": "https://schema.org", "@type": "Product", "@id": "https://ufc.proptechusa.ai/#product", name: "PropTechUSA UFC Intelligence API", description: "Normalized UFC data plus proprietary PropBetEdge Fight DNA and Matchup DNA, delivered through one developer API.", brand: { "@type": "Brand", name: "PropTechUSA" }, image: "https://ufc.proptechusa.ai/og.png", offers: order.filter((k) => plans[k as keyof typeof plans].price_usd_month !== null).map((k) => ({ "@type": "Offer", name: `${plans[k as keyof typeof plans].name} plan`, price: plans[k as keyof typeof plans].price_usd_month, priceCurrency: "USD", availability: "https://schema.org/InStock", url: `https://ufc.proptechusa.ai/pricing#plan-${k}` })) },
];
---
<Base title="UFC Intelligence API — Fighter Data, Fight Stats & Fight DNA | PropTechUSA.ai" description="Developer-ready UFC event, fighter, fight-card and round-level data with proprietary PropBetEdge Fight DNA and matchup intelligence." path="/" jsonLd={jsonLd}>
  <section class="hero hero-v2">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap">
      <div>
        <div class="kicker"><span class="pt">PropTechUSA</span><span class="sep">/</span><span>UFC Intelligence API</span><span class="sep">/</span><span class="chip derived">Powered by PropBetEdge Fight DNA</span></div>
        <h1>Build the product,<br />not the data pipeline.</h1>
        <p class="lede">Normalized UFC events, fighters, cards, results and round-level statistics — plus proprietary PropBetEdge Fight DNA and Matchup DNA — through one developer API.</p>
        <div class="actions">
          <a class="btn primary" href="/pricing">Get API access</a>
          <a class="btn secondary" href="/workspace">Open Workspace</a>
          <a class="btn ghost" href="/docs">Read the docs →</a>
        </div>
        <div class="trust"><span>Versioned contracts</span><span>Explicit provenance</span><span>Truthful nulls</span><span>Edge delivery</span></div>
      </div>
      <div class="hero-demo">
        <ApiRequest path={`/v1/ufc/fighters/${HERO_ID}/dna`} plan="pro" compact />
        <div class="demo" style="padding:16px">
          <FighterPreview fighter={hero.fighter} size="mini" nextBout={false} />
          <div style="height:12px"></div>
          <FightDnaPreview snapshot={hero.dna} compact keys={["sig_landed_per_min", "sig_accuracy", "sig_defense", "td_attempts_per_15", "finish_rate", "pace_retention_r3_vs_r1"]} />
          <div class="actions-row" style="margin-top:10px;align-items:center;justify-content:space-between">
            <span class="mono small muted">{heroCoverage}</span>
            <JsonDrawer json={ex.fighter_dna.body} path={`/v1/ufc/fighters/${HERO_ID}/dna`} title="Fighter Fight DNA response" note={`live · captured ${fmtDate(ex.fighter_dna.captured_at)} · subset`} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="trust-strip">
        <div><b>Versioned contract</b><span>Data contract {contract.api_version}, Fight DNA definitions v{contract.fight_dna_definition_version}, drift-guarded against the canonical API.</span></div>
        <div><b>Explicit provenance</b><span>Every derived number carries sample, confidence, source families, as-of date and definition version.</span></div>
        <div><b>Truthful nulls</b><span>Missing data is null or an explicit unavailable state. Never a fake zero, odd or pick.</span></div>
        <div><b>Edge delivery</b><span>One canonical engine, one gateway, plan-aware caching on Cloudflare's edge.</span></div>
      </div>
      <p class="small muted center" style="margin:16px 0 0">PropTechUSA operates the infrastructure. <a href="https://ufc.propbetedge.ai" rel="noopener">PropBetEdge UFC</a> is one production application built on this intelligence layer — every dark panel below is a simplified version of a surface it ships, rendered from the real API responses shown.</p>
    </div>
  </section>

  <section class="section" id="fighter-profile">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Fighter profile</p><h2>A complete fighter page, from four calls.</h2><p class="lede">Identity, record, ranking, rights-cleared media, career stats and Fight DNA. Rendered here from the live responses for {silva.fighter.name}.</p></div></div>
      <Demo eyebrow="Fighter API" title={silva.fighter.name} intro={`Next: ${silva.fighter.next_bout?.event?.name} · ${fmtDate(silva.fighter.next_bout?.event?.event_date)}`} captured={fmtDate(silva.captured_at)}
        endpoints={[{ path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/history", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/stats", plan: "pro" }, { path: "/v1/ufc/fighters/{id}/dna", plan: "pro" }]}
        workspace={`/workspace?tool=fighter&id=${SILVA_ID}`} json={ex.silva_detail.body} jsonPath={silva.paths.detail} jsonNote="subset: images[] and history[] shortened" pbeLabel="See the live PropBetEdge fighter page →">
        <FighterPreview fighter={silva.fighter} size="hero" showCareer />
        <div style="height:14px"></div>
        <FightDnaPreview snapshot={silva.dna} title="Fight DNA snapshot" keys={["finish_rate", "ko_finish_rate", "sig_landed_per_min", "sig_accuracy", "td_attempts_per_15", "pace_retention_r3_vs_r1"]} />
        <div slot="aside" class="powered">
          <p class="eyebrow">Recent history <span class="chip source">Source</span></p>
          <ul class="hist-list" style="margin-bottom:0">{silva.history.map((h: any) => <li><span class:list={["outcome", h.outcome || "none"]}>{h.outcome || "—"}</span><span><b>{h.opponent?.name || "TBA"}</b><br /><span class="small muted">{h.event?.name} · {h.event?.event_date}</span></span><span class="small muted">{h.result?.method || (h.outcome ? "" : "scheduled")}</span></li>)}</ul>
        </div>
      </Demo>
    </div>
  </section>

  <section class="section" id="fight-week">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Fight Week</p><h2>Current card, matchup read, fighter faces.</h2><p class="lede">Powered by events + cards + fighters + Matchup DNA. This is the next event exactly as the API returns it today.</p></div></div>
      <Demo eyebrow="Fight Week API" title={event.event.name} intro={`${fmtDate(event.event.event_date)} · ${event.event.venue}, ${event.event.city} · ${event.bout_count} bouts · ${event.event.card_status}`} captured={fmtDate(event.captured_at)}
        endpoints={[{ path: "/v1/ufc/events?status=upcoming", plan: "developer" }, { path: "/v1/ufc/events/{id}/card", plan: "developer" }, { path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/dna", plan: "pro" }, { path: "/v1/ufc/matchups/{a}/{b}/dna", plan: "ultra" }]}
        workspace="/workspace?tool=card" json={ex.noche_card.body} jsonPath={event.path} jsonNote="subset: 2 of 13 bouts, images[] omitted" pbeLabel="See the live PropBetEdge Fight Week →">
        <EventCardPreview event={event} limit={7} />
        <div slot="aside">
          <MatchupPreview matchup={matchup} compact />
        </div>
      </Demo>
    </div>
  </section>

  <section class="section" id="rankings">
    <div class="wrap">
      <div class="grid cols-2" style="align-items:start">
        <div>
          <p class="eyebrow">Rankings</p>
          <h2>Champion, top 15, movement.</h2>
          <p class="lede">The verified ufc.com snapshot, linked to canonical fighter ids so every row can open a fighter profile, Fight DNA or a matchup.</p>
          <p class="small muted">Rankings are source facts (attribution required). The API never invents a ranking; unlinked names return <code>fighter: null</code>.</p>
        </div>
        <Demo eyebrow="Rankings API" title={`${fw.division.label}`} captured={fmtDate(fw.captured_at)} single
          endpoints={[{ path: "/v1/ufc/rankings?division=FEATHERWEIGHT", plan: "developer" }, { path: "/v1/ufc/fighters/{id}?include=ranking", plan: "developer" }, { path: "/v1/ufc/fighters/media?ids=…", plan: "developer" }]}
          workspace="/workspace?tool=rankings&division=FEATHERWEIGHT" json={ex.rankings_featherweight.body} jsonPath={fw.path} jsonNote="subset: 3 entries" pbeLabel="See the live PropBetEdge rankings →">
          <RankingsPreview rankings={fw} limit={10} />
        </Demo>
      </div>
    </div>
  </section>

  <section class="section" id="fight-dna" style="background:linear-gradient(180deg,var(--paper) 0%,#fdf9ee 100%)">
    <div class="wrap">
      <p class="eyebrow gold">Proprietary intelligence</p>
      <h2 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">Fight DNA</h2>
      <div class="split">
        <div>
          <p class="lede">Raw statistics describe individual events. Fight DNA reconstructs event-dated bout and round history into proprietary fighter intelligence: stance matchups, striking patterns, grappling, finishing behavior, round progression and context.</p>
          <p>Every derived metric includes its sample, provenance, confidence, as-of date and definition version. Derived by PropBetEdge, labelled <span class="chip derived">PBE derived</span>, never presented as official UFC statistics.</p>
          <div class="dna-grid" style="grid-template-columns:repeat(2,minmax(0,1fr));margin-top:16px">
            {families.map((f) => <div class="dna"><h3>{f.t}</h3><div class="keys">{f.keys.join(" · ")}</div></div>)}
          </div>
          <p style="margin-top:18px"><a class="btn gold" href="/learn/fight-dna">How Fight DNA is built</a> <a class="btn ghost" href="/docs#fight-dna">Fight DNA docs →</a></p>
        </div>
        <div>
          <p class="eyebrow gold">Every number has receipts</p>
          {rec && <ReceiptPreview fighter={rec.fighter} metric={rec.metric} />}
          <p class="small muted" style="margin-top:10px">A verbatim <code>MetricObject</code> from the live API. A low sample is reported as a low sample; a zero denominator is a <code>null</code> with <code>confidence: "insufficient"</code>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="matchup-dna">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow gold">Matchup DNA API <span class="chip plan-ultra">Ultra+</span></p><h2>Two fighters in. Matchup intelligence out.</h2><p class="lede">Each fighter compared against the opponent actually in front of them. Insights are emitted only above documented thresholds; everything else is a named warning. This is why Ultra exists.</p></div></div>
      <Demo eyebrow="Matchup DNA" title={`${matchup.fighters[0].name} vs ${matchup.fighters[1].name}`} intro={`${event.event.name} main event · stance context: ${matchup.stance_context.context.replace(/_/g, " ")}`} captured={fmtDate(matchup.captured_at)} single
        endpoints={[{ path: "/v1/ufc/matchups/{a}/{b}/dna", plan: "ultra" }, { path: "/v1/ufc/fighters/{id}/dna", plan: "pro" }, { path: "/v1/ufc/fighters/{id}/splits", plan: "pro" }]}
        workspace={`/workspace?tool=matchup&a=${SILVA_ID}&b=${DELGADO_ID}`} json={ex.matchup_noche.body} jsonPath={matchup.path} jsonNote="subset: 3 of 18 comparisons, 2 of 5 insights" pbeLabel="See the live PropBetEdge matchup page →">
        <MatchupPreview matchup={matchup} />
      </Demo>
      <p class="small muted" style="margin-top:12px">Honest by design: {matchup.fighters[0].name} has no stat-covered rounds in the archive yet, so his rate metrics are <code>null</code> and only result-based insights fire. The response says so in <code>warnings[]</code> instead of guessing.</p>
    </div>
  </section>

  <section class="section" id="build">
    <div class="wrap">
      <p class="eyebrow">Build more than a stats page</p>
      <h2>What the API can power.</h2>
      <div class="build-grid" style="margin-top:24px">
        {[
          ["Fighter profile", "Photo with attribution, record, rank, next bout, career stats, Fight DNA.", ["/fighters/{id}", "/fighters/{id}/history", "/fighters/{id}/stats", "/fighters/{id}/dna"], "developer", "#fighter-profile"],
          ["Matchup engine", "Fighter vs fighter: stance, reach, pace, grappling, finish windows, threshold-gated reads.", ["/matchups/{a}/{b}/dna", "/fighters/{id}/splits"], "ultra", "#matchup-dna"],
          ["Fight Week app", "Current card, main-event faces, matchup intelligence, official videos, rankings implications.", ["/events?status=upcoming", "/events/{id}/card", "/events/{id}/videos", "/events/{id}/intelligence"], "developer", "#fight-week"],
          ["Rankings product", "Champion, top 15, movement, linked fighter ids and media.", ["/rankings", "/fighters/media?ids=…"], "developer", "#rankings"],
          ["Research workflow", "Historical as-of snapshots, round-level rows, provenance on every value.", ["/fighters/{id}/dna?as_of=", "/bouts/{id}/stats", "/dna/query"], "pro", "/docs#as-of"],
          ["Media layer", "Rights-labelled portraits (author, license, source) and official video metadata; never rehosted.", ["/fighters/{id}", "/fighters/media", "/videos"], "developer", "/docs#media"],
        ].map(([t, p, eps, plan, href]: any) => (
          <div class="build">
            <div class="section-head" style="margin:0"><h3 style="margin:0;font-size:1.15rem">{t}</h3><span class:list={["chip", `plan-${plan}`]}>{plans[plan as keyof typeof plans].name}+</span></div>
            <p class="small" style="margin:0;color:var(--ink-2)">{p}</p>
            <div class="endpoints">{eps.map((e: string) => <div>GET /v1/ufc{e}</div>)}</div>
            <a class="btn ghost" href={href} style="justify-self:start">See the demo →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight" id="surfaces">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Surface coverage</p><h2>Every PropBetEdge UFC surface, and the endpoints behind it.</h2><p class="lede">PropBetEdge UFC is one production application on this intelligence layer. This is exactly which of its surfaces the commercial API delivers today — and which it does not.</p></div></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Consumer surface</th><th>API coverage</th><th>Endpoints</th><th>Minimum plan</th></tr></thead>
          <tbody>
            {[
              ["Fight Week", "Full", "/events?status=upcoming · /events/{id}/card · /events/{id}/intelligence", "developer"],
              ["Fighter profile", "Full", "/fighters/{id} · /fighters/{id}/history · /fighters/{id}/stats · /fighters/{id}/dna", "developer"],
              ["Fight DNA", "Full (proprietary)", "/fighters/{id}/dna · /splits · /round-profile · /finish-profile · /dna/metrics", "pro"],
              ["Matchup DNA", "Full (proprietary)", "/matchups/{a}/{b}/dna · /dna/query", "ultra"],
              ["Rankings", "Full", "/rankings?division=&womens=", "developer"],
              ["Fighter media", "Metadata with license + attribution", "/fighters/{id} (images[]) · /fighters/media?ids=", "developer"],
              ["Official video", "Metadata and official links only, never rehosted", "/videos · /fighters/{id}/videos · /events/{id}/videos · /bouts/{id}/videos", "developer"],
              ["History and archive", "Full", "/events?status=all · /events/{id}/card · /bouts/{id}/stats · /results", "developer"],
              ["Contender Series (DWCS)", "Included as events", "/events?status= (DWCS cards are in the schedule)", "developer"],
              ["Newsroom", "PropBetEdge editorial", "/news · /articles/{slug} · /events/{id}/articles", "developer"],
              ["Live wire (third-party headlines)", "Not on self-serve plans, rights review pending", "/wire", "enterprise"],
              ["Referees", "Not exposed by the commercial API today", "consumer surface only", null],
              ["Hall of Fame", "Not exposed by the commercial API today", "consumer surface only", null],
            ].map(([surface, coverage, eps, plan]: any) => (
              <tr>
                <td><b>{surface}</b></td>
                <td class="small">{coverage}</td>
                <td class="small mono" style="color:var(--muted)">{eps}</td>
                <td>{plan ? <span class:list={["chip", `plan-${plan}`]}>{plans[plan as keyof typeof plans].name}+</span> : <span class="chip">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:12px">Referee and Hall of Fame data exist in the upstream product but are not part of the {contract.api_version} commercial contract. If you need them, <a href="mailto:sales@proptechusa.ai">talk to us about Enterprise</a>.</p>
    </div>
  </section>

  <section class="section band" id="workspace">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Developer Workspace</p>
          <h2>Buy a key. Run the current card in 30 seconds.</h2>
          <p class="lede">Search fighters by name, run Fight DNA and Matchup DNA, render rankings and cards, inspect status, latency, plan and rate-limit headers, and copy the exact cURL, JavaScript or Python that reproduces the call.</p>
          <p><a class="btn gold" href="/workspace">Open Workspace →</a> <a class="btn ghost" href="/docs" style="color:var(--gold-2)">Quickstart →</a></p>
        </div>
        <div class="card flat" style="display:grid;gap:8px">
          {[["Current card", "GET /v1/ufc/events/{id}/card", "developer"], ["Fighter explorer", "search → overview · history · stats · Fight DNA · media", "developer"], ["Compare fighters", "GET /v1/ufc/matchups/{a}/{b}/dna", "ultra"], ["Rankings", "GET /v1/ufc/rankings?division=", "developer"], ["Fight DNA", "dna · splits · round-profile · finish-profile", "pro"], ["Any endpoint", "PREVIEW / JSON · request inspector · copy snippets", "developer"]].map(([t, d, p]) => (
            <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #2a3a31"><div><b>{t}</b><div class="mono small muted">{d}</div></div><span class:list={["chip", `plan-${p}`]}>{plans[p as keyof typeof plans].name}+</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="plans">
    <div class="wrap">
      <p class="eyebrow">Plans</p>
      <h2>Not just UFC data.</h2>
      <p class="lede">Every plan starts with normalized fight records. Pro unlocks fighter Fight DNA, Ultra unlocks Matchup DNA, Scale is production infrastructure.</p>
      <div class="pricing-grid" style="margin-top:28px">
        {order.filter((k) => k !== "enterprise").map((k) => { const p = plans[k as keyof typeof plans]; return (
          <div class:list={["plan", { recommended: (p as any).recommended }]}>
            {(p as any).recommended && <span class="rec">Recommended</span>}
            <div class="tier">{p.name}</div>
            <div class="price">${p.price_usd_month}<small>/mo</small></div>
            <div class="pos">{p.tagline}</div>
            <div class="limits">{fmtNumber(p.included_requests)} req/mo · {p.rate_limit_per_min} req/min</div>
            <a class:list={["btn cta", (p as any).recommended ? "gold" : "secondary"]} href={`/pricing#plan-${k}`}>{p.cta}</a>
          </div>
        ); })}
      </div>
      <p class="small muted" style="margin-top:16px">Enterprise: dedicated infrastructure, custom endpoints, licensing and partnerships. <a href="/pricing">Full pricing and entitlement matrix →</a> · Coverage today: {fmtNumber(counts.fighters)} fighters, {fmtNumber(counts.events)} events, {fmtNumber(counts.bouts)} bouts, {fmtNumber(counts.round_stat_rows)} round rows, {fmtNumber(counts.images)} licensed portraits (as of {fmtDate(counts.captured_at)}).</p>
    </div>
  </section>

  <section class="section tight" id="quickstart">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Quickstart</p>
          <h3>Three lines to your first response.</h3>
          <p class="small muted">Bearer key, JSON envelope, rate-limit headers on every call. Same body on the direct host and on RapidAPI.</p>
          <p><a class="btn secondary" href="/docs">Documentation</a> <a class="btn ghost" href="/docs/reference">Interactive reference →</a></p>
        </div>
        <ApiRequest path="/v1/ufc/events?status=upcoming&limit=3" plan="developer" />
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap">
      <p class="eyebrow">Independent · not an official UFC API</p>
      <h2 style="font-size:clamp(2rem,4vw,3rem)">The developer platform for UFC intelligence.</h2>
      <p class="lede" style="margin:0 auto 20px">Deep canonical data, rights-labelled media, proprietary Fight DNA and Matchup DNA, one contract. Buy a key, open the Workspace, ship.</p>
      <a class="btn primary" href="/pricing">Get API access</a> <a class="btn secondary" href="/workspace">Open Workspace</a>
      <p class="small muted" style="margin-top:18px">PropTechUSA and PropBetEdge are independent products and are not affiliated with, endorsed by, or sponsored by UFC, Zuffa LLC, TKO Group, ESPN or any sportsbook. <a href="/legal">Rights and attribution →</a></p>
    </div>
  </section>
</Base>
