---
import Base from "../layouts/Base.astro";
import ApiRequest from "../components/ApiRequest.astro";
import JsonDrawer from "../components/JsonDrawer.astro";
import Demo from "../components/Demo.astro";
import FightPoster from "../components/FightPoster.astro";
import FighterPreview from "../components/FighterPreview.astro";
import FightDnaPreview from "../components/FightDnaPreview.astro";
import MatchupPreview from "../components/MatchupPreview.astro";
import EventCardPreview from "../components/EventCardPreview.astro";
import RankingsPreview from "../components/RankingsPreview.astro";
import ReceiptPreview from "../components/ReceiptPreview.astro";
import gen from "../generated/entitlements.json";
import show from "../generated/showcase.json";
import { fmtDate, fmtNumber } from "../lib/hl";
import { freshness } from "../lib/freshness";

const plans = gen.plans.plans;
const order = gen.plans.plan_order;
const contract = gen.contract;
/* Every data-bearing block below renders the generated showcase snapshot (apps/web/src/generated/showcase.json),
   refreshed on a schedule by scripts/refresh-showcase.mjs. Subjects are auto-selected on real coverage with
   men's divisions leading the primary composition; women's divisions stay on the card strip, rankings and docs. */
const fresh = freshness(show.generated_at);
const counts = show.counts;
const reg = show.registry;
const event = show.event;
const mainBout = event.bouts.reduce((m: any, b: any) => (b.bout_order > m.bout_order ? b : m), event.bouts[0]);
const HA = mainBout.fighter_a, HB = mainBout.fighter_b;
const fighterShow = show.fighter;
const flagship = show.matchup;
const FA = flagship.fighters[0], FB = flagship.fighters[1];
const mw = show.rankings;
const womens = show.womens;
const rec = show.provenance;
const EVENT_ID = event.event.id, SHOW_FIGHTER = fighterShow.fighter.id, FA_ID = FA.id, FB_ID = FB.id;
const fam = (k: string) => (reg?.families?.[k] || []);
const famCard = (t: string, k: string, blurb: string, picks: [string, string][]) => ({ t, blurb, keys: fam(k).map((m: any) => m.metric_key), picks });
const families = [
  famCard("Stance DNA", "stance", "Record, finish and strike differential split by the opponent's listed stance, plus open- and same-stance context.", [["stance_record", "W/L/D vs each stance"], ["stance_finish_rate", "Finishes vs that stance"], ["open_stance_record", "Orthodox vs southpaw"]]),
  famCard("Striking DNA", "striking", "Pace, accuracy and defense per observed minute; head, body and leg target shares; distance, clinch and ground phase shares.", [["sig_landed_per_min", "Sig. strikes landed / min"], ["sig_accuracy", "Strike accuracy"], ["head_attack_share", "Head target share"]]),
  famCard("Grappling DNA", "grappling", "Takedown volume and accuracy per 15 observed minutes, control seconds per takedown, control share, submission attempts.", [["td_attempts_per_15", "Takedown attempts / 15"], ["td_accuracy", "Takedown accuracy"], ["control_seconds_per_td", "Control seconds / TD"]]),
  famCard("Finish DNA", "finish", "How and when finishes happen: finish, KO and submission rates, finish-round distribution, median finish time.", [["finish_rate", "Finish rate of wins"], ["ko_finish_rate", "KO/TKO finish rate"], ["finish_round_distribution", "Finish round spread"]]),
  famCard("Round DNA", "pace", "Whether round-one pace survives into rounds two and three, championship-round delta, defensive drift.", [["pace_retention_r3_vs_r1", "Pace retention R3/R1"], ["championship_round_delta", "Championship-round delta"], ["defensive_drift_r3_vs_r1", "Defensive drift"]]),
  famCard("Context DNA", "context", "Records under specific conditions: short notice, three- and five-round bouts, title fights, main events.", [["five_round_record", "Five-round record"], ["title_bout_record", "Title-bout record"], ["short_notice_record", "Short-notice record"]]),
];
const metricCount = Object.values(reg?.families || {}).reduce((n: number, f: any) => n + f.length, 0);
const divisionOf = (f: any) => { const p = (f.ranking?.positions || []).filter((x: any) => !x.is_p4p)[0]; return p ? p.label : null; };
const jsonLd = [
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": "https://ufc.proptechusa.ai/#app", name: "PropTechUSA UFC Intelligence API", applicationCategory: "DeveloperApplication", operatingSystem: "Any", url: "https://ufc.proptechusa.ai", description: "Developer-ready UFC event, fighter, fight-card and round-level data with proprietary PropBetEdge Fight DNA and matchup intelligence.", softwareVersion: contract.api_version, publisher: { "@id": "https://proptechusa.ai/#organization" }, offers: { "@type": "AggregateOffer", priceCurrency: "USD", lowPrice: 79, highPrice: 1499, offerCount: 4, url: "https://ufc.proptechusa.ai/pricing" } },
  { "@context": "https://schema.org", "@type": "Product", "@id": "https://ufc.proptechusa.ai/#product", name: "PropTechUSA UFC Intelligence API", description: "Normalized UFC data plus proprietary PropBetEdge Fight DNA and Matchup DNA, delivered through one developer API.", brand: { "@type": "Brand", name: "PropTechUSA" }, image: "https://ufc.proptechusa.ai/og.png", offers: order.filter((k) => plans[k as keyof typeof plans].price_usd_month !== null).map((k) => ({ "@type": "Offer", name: `${plans[k as keyof typeof plans].name} plan`, price: plans[k as keyof typeof plans].price_usd_month, priceCurrency: "USD", availability: "https://schema.org/InStock", url: `https://ufc.proptechusa.ai/pricing#plan-${k}` })) },
];
---
<Base title="UFC Intelligence API — Fighter Data, Fight Stats & Fight DNA | PropTechUSA.ai" description="Every fighter, every card, every round, one API. Normalized UFC events, fighters, rankings, cards and round-level stats plus proprietary PropBetEdge Fight DNA and Matchup DNA." path="/" jsonLd={jsonLd}>
  <!-- 1. HERO -->
  <section class="hero-v2">
    <div class="hero-fence" aria-hidden="true"></div>
    <div class="wrap">
      <div>
        <p class="eyebrow">PropTechUSA sports data · UFC Intelligence API</p>
        <h1>Build the fight product.<br /><span class="gold-em">Not the data pipeline.</span></h1>
        <p class="lede">Every fighter. Every card. Every round. Normalized UFC events, fighters, rankings, fight cards and round-level stats — plus proprietary PropBetEdge Fight DNA and Matchup DNA.</p>
        <div class="actions">
          <a class="btn primary" href="/pricing">Get API access</a>
          <a class="btn secondary" href="/workspace">Open Workspace</a>
          <a class="btn ghost" href="/docs">View docs →</a>
        </div>
        <div class="statstrip">
          <div><b>{fmtNumber(counts.events)}</b><span>Events</span></div>
          <div><b>{fmtNumber(counts.fighters)}</b><span>Fighters</span></div>
          <div><b>{fmtNumber(counts.bouts)}</b><span>Bouts</span></div>
          <div><b>{fmtNumber(counts.round_stat_rows)}</b><span>Rounds of stats</span></div>
          <div class="accent"><b>Fight DNA v{contract.fight_dna_definition_version}</b><span>Derived intelligence</span></div>
        </div>
      </div>
      <div>
        <FightPoster a={HA} b={HB} eventName={event.event.name} eventDate={event.event.event_date} venue={event.event.venue} city={event.event.city} region={event.event.region} tall
          label={`Main event · ${mainBout.weight_class.replace(/_/g, " ").toLowerCase()} · ${mainBout.scheduled_rounds} rounds`} badge="Fight week" meta={`${event.bout_count} bouts · ${event.event.card_status}`}
          endpoints={[{ path: `/v1/ufc/events/${"{id}"}/card` }, { path: `/v1/ufc/fighters/${"{id}"}` }, { path: `/v1/ufc/matchups/${"{a}"}/${"{b}"}/dna` }]}
          status={{ code: 200, ms: 42, plan: "Ultra" }} />
      </div>
    </div>
  </section>

  <!-- 2. FIGHTER PROFILE -->
  <section class="section band-deep" id="fighter-profile">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Fighter API</p><h2>A complete fighter page,<br /><span class="gold-em">from four calls.</span></h2><p class="lede">Identity, record, ranking, rights-cleared media, career stats and proprietary Fight DNA.</p></div>
        <a class="btn secondary" href={`/workspace?tool=fighter&id=${SHOW_FIGHTER}`}>Build this profile →</a>
      </div>
      <Demo eyebrow={`${divisionOf(fighterShow.fighter) || "Fighter"}${(fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0]?.rank === 0 ? " champion" : (fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0] ? " #" + (fighterShow.fighter.ranking?.positions || []).filter((p: any) => !p.is_p4p)[0].rank : ""} · selected on live coverage`} title={fighterShow.fighter.name} intro={`${fighterShow.fighter.record_w}-${fighterShow.fighter.record_l} · ${fighterShow.dna.sample_stat_bouts} stat-covered bouts · ${fighterShow.dna.sample_rounds} rounds · ${fmtNumber(fighterShow.dna.sample_seconds / 60, 0)} observed minutes`} captured={fresh.capturedAt}
        endpoints={[{ path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/history", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/stats", plan: "pro" }, { path: "/v1/ufc/fighters/{id}/dna", plan: "pro" }]}
        workspace={`/workspace?tool=fighter&id=${SHOW_FIGHTER}`} json={fighterShow.raw} jsonPath={fighterShow.paths.detail} jsonNote="subset: images[] and history[] shortened" pbeLabel="See the live PropBetEdge fighter page →">
        <FighterPreview fighter={fighterShow.fighter} size="hero" showCareer />
        <div style="height:16px"></div>
        <FightDnaPreview snapshot={fighterShow.dna} title="Fight DNA" keys={["sig_landed_per_min", "sig_accuracy", "sig_defense", "knockdowns_per_15", "td_attempts_per_15", "pace_retention_r3_vs_r1"]} />
        <div slot="aside" class="powered">
          <p class="eyebrow">Recent bouts <span class="chip source">Source</span></p>
          <ul class="hist-list">{fighterShow.history.slice(0, 5).map((h: any) => <li><span class:list={["outcome", h.outcome || "none"]}>{h.outcome || "—"}</span><span><b>{h.opponent?.name || "TBA"}</b><br /><span class="small muted">{h.event?.name}</span></span><span class="small muted">{h.result?.method || "scheduled"}</span></li>)}</ul>
        </div>
      </Demo>
    </div>
  </section>

  <!-- 3. FIGHT WEEK -->
  <section class="section" id="fight-week">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Fight Week API</p><h2>Build Fight Week.</h2><p class="lede">The current event, main card, fighter faces and matchup intelligence — the whole fight-week surface from four endpoints.</p></div>
        <a class="btn secondary" href="/workspace?tool=card">Open in Workspace →</a>
      </div>
      <Demo eyebrow="Current card · rendered from the response" title="The next card, end to end" intro="Event, ordered bouts, card positions, both fighters with rights-cleared media, and the matchup read for the co-main." captured={fresh.capturedAt}
        endpoints={[{ path: "/v1/ufc/events?status=upcoming", plan: "developer" }, { path: "/v1/ufc/events/{id}/card", plan: "developer" }, { path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/matchups/{a}/{b}/dna", plan: "ultra" }]}
        workspace="/workspace?tool=card" json={event.raw} jsonPath={event.path} jsonNote="subset: 2 of 13 bouts, images[] omitted" pbeLabel="See the live PropBetEdge Fight Week →">
        <EventCardPreview event={event} limit={8} />
        <div slot="aside">
          {womens.matchup ? (
            <div class="powered" style="margin-bottom:12px">
              <p class="eyebrow">{womens.matchup.label} · {womens.matchup.weight_class.replace(/_/g, " ").toLowerCase()} <span class="chip derived">PBE derived</span></p>
              <p class="small muted" style="margin:0 0 10px">{womens.matchup.fighters[0].name} vs {womens.matchup.fighters[1].name} — every division on the card resolves through the same endpoints.</p>
              <ul style="margin-bottom:0">{womens.matchup.insights.slice(0, 2).map((i: any) => <li style="display:block;color:var(--dim);font-family:var(--font-ui);font-size:13px;line-height:1.5">{i.explanation}</li>)}</ul>
            </div>
          ) : (
            <div class="powered" style="margin-bottom:12px"><p class="eyebrow">Every division</p><p class="small muted" style="margin:0">This card has no women's bout scheduled. Every division resolves through the same endpoints; see the <a href="/workspace?tool=rankings">Workspace rankings tool</a>.</p></div>
          )}
        </div>
      </Demo>
    </div>
  </section>

  <!-- 4. MATCHUP DNA -->
  <section class="section band-gold" id="matchup-dna">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Matchup DNA API <span class="chip plan-ultra">Ultra</span></p><h2>Two fighters in.<br /><span class="gold-em">Matchup intelligence out.</span></h2><p class="lede">Each fighter measured against the opponent actually in front of them. Insights fire only above documented thresholds; everything else is a named warning.</p></div>
        <a class="btn secondary" href={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`}>Open in Workspace →</a>
      </div>
      <Demo eyebrow={`${flagship.weight_class ? flagship.weight_class.replace(/_/g, " ").toLowerCase() : "matchup"} · ${flagship.label}${flagship.on_current_card ? " · on the current card" : ""}`} title={`${FA.name} vs ${FB.name}`} intro={`${flagship.meta.comparable} of ${flagship.meta.comparisons} metrics comparable · ${flagship.insights.length} insights above threshold · stance context ${flagship.stance_context.context.replace(/_/g, " ")}`} captured={fresh.capturedAt} single
        endpoints={[{ path: "/v1/ufc/matchups/{a}/{b}/dna", plan: "ultra" }, { path: "/v1/ufc/fighters/{id}", plan: "developer" }, { path: "/v1/ufc/fighters/{id}/splits", plan: "pro" }]}
        workspace={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`} json={flagship.raw} jsonPath={flagship.path} jsonNote="subset: 3 of 18 comparisons, 2 of 12 insights" pbeLabel="See the live PropBetEdge matchup →">
        <MatchupPreview matchup={flagship} />
      </Demo>
    </div>
  </section>

  <!-- 5. RANKINGS -->
  <section class="section" id="rankings">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Rankings API · {mw.division.label}</p><h2>Champion, top 15, movement.</h2><p class="lede">The verified ufc.com snapshot, linked to canonical fighter ids so every row opens a profile, Fight DNA or a matchup. Portraits come from one bulk media call. Every men's and women's division resolves the same way.</p></div>
        <a class="btn secondary" href={`/workspace?tool=rankings&division=${mw.division.key}`}>Open in Workspace →</a>
      </div>
      <div class="demo">
        <div class="demo-body">
          <RankingsPreview rankings={mw} limit={8} />
          <div class="powered">
            <p class="eyebrow">Powered by</p>
            <ul>
              <li><span class="m">GET</span><span>{mw.path.replace("/v1/ufc", "")}</span><span class="chip plan-developer">Developer+</span></li>
              <li><span class="m">GET</span><span>/v1/ufc/fighters/media?ids=…</span><span class="chip plan-developer">Developer+</span></li>
              <li><span class="m">GET</span><span>/v1/ufc/fighters/{"{id}"}?include=ranking</span><span class="chip plan-developer">Developer+</span></li>
            </ul>
            <div class="actions-row">
              <a class="btn secondary" href={`/workspace?tool=rankings&division=${mw.division.key}`}>Open in Workspace →</a>
              <JsonDrawer json={mw.raw} path={mw.path} title="Rankings response" note="subset: 3 entries" label="View JSON →" />
            </div>
            <a class="pbe-link" href="https://ufc.propbetedge.ai/rankings" rel="noopener"><span class="m">PropBetEdge UFC</span> See the live rankings product →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FIGHT DNA -->
  <section class="section band-deep" id="fight-dna">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Proprietary intelligence</p><h2>Raw stats tell you what happened.<br /><span class="gold-em">Fight DNA shows the pattern.</span></h2><p class="lede">Event-dated bout and round history rebuilt into as-of fighter intelligence: stance matchups, striking, grappling, finishing, round progression and context. Six families, {metricCount} versioned metrics.</p></div>
        <a class="btn secondary" href="/learn/fight-dna">Methodology →</a>
      </div>
      <div class="dna-grid">
        {families.map((f) => (
          <div class="dna">
            <h3>{f.t}</h3>
            <p>{f.blurb}</p>
            <div class="metricline">{f.picks.filter(([k]) => f.keys.includes(k)).map(([k, label]) => <div><span>{label}</span><b>{f.keys.includes(k) ? "✓" : "—"}</b></div>)}</div>
            <div class="keys">{f.keys.length} metrics · {f.keys.slice(0, 4).join(" · ")}{f.keys.length > 4 ? " …" : ""}</div>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:18px">Every value carries its sample, confidence, coverage, source families, as-of date and definition version. Derived by PropBetEdge; never presented as official UFC statistics.</p>
    </div>
  </section>

  <!-- 7. RECEIPTS -->
  <section class="section" id="receipts">
    <div class="wrap">
      <p class="eyebrow">Provenance</p>
      <h2>Every number has receipts.</h2>
      <div class="receipt" style="margin-top:26px">
        {rec && <ReceiptPreview fighter={rec.fighter} metric={rec.metric} />}
        <div>
          <p class="lede">This is a verbatim <code>MetricObject</code> from the live API, not a marketing number. A low sample is reported as a low sample. A zero denominator is a <code>null</code> with <code>confidence: "insufficient"</code>, never a fake zero.</p>
          <ApiRequest path={fighterShow.paths.dna} plan="pro" compact />
          <div class="actions-row" style="margin-top:14px">
            <JsonDrawer json={fighterShow.raw_dna} path={fighterShow.paths.dna} title="Fighter Fight DNA response" note={`captured ${fresh.capturedAt} · subset`} label="View full response →" />
            <a class="btn ghost" href="/learn/fight-dna#provenance">How confidence is computed →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. WORKSPACE -->
  <section class="section band-deep" id="workspace">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Developer Workspace</p><h2>Buy a key. Run the current card in 30 seconds.</h2><p class="lede">Search fighters by name, run Fight DNA and Matchup DNA, render cards and rankings, then copy the exact cURL, JavaScript or Python that reproduces the call.</p></div>
        <a class="btn primary" href="/workspace">Open Workspace →</a>
      </div>
      <div class="build-grid">
        {[
          ["Current Fight Week", "One click: the next event and its full card, rendered.", "/v1/ufc/events/{id}/card", "developer", "/workspace?tool=card"],
          ["Explore a fighter", "Search by name, then Overview, History, Stats, Fight DNA and Media tabs.", "/v1/ufc/fighters/{id}…", "developer", `/workspace?tool=fighter&id=${SHOW_FIGHTER}`],
          ["Compare fighters", "Pick two fighters and render the full matchup card with insights.", "/v1/ufc/matchups/{a}/{b}/dna", "ultra", `/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`],
          ["View rankings", "Champion and top 15 with portraits, in every division.", "/v1/ufc/rankings", "developer", `/workspace?tool=rankings&division=${mw.division.key}`],
          ["Test Fight DNA", "Snapshot, stance splits, round and finish profiles, with as-of dates.", "/v1/ufc/fighters/{id}/dna", "pro", `/workspace?tool=dna&id=${SHOW_FIGHTER}`],
          ["Any endpoint", "Request builder with rendered preview, JSON and code snippets.", "/v1/ufc/*", "developer", "/workspace?tool=custom"],
        ].map(([t, p, ep, plan, href]: any) => (
          <a class="build" href={href} style="text-decoration:none">
            <div class="section-head" style="margin:0"><h3 style="margin:0">{t}</h3><span class:list={["chip", `plan-${plan}`]}>{plans[plan as keyof typeof plans].name}+</span></div>
            <p>{p}</p>
            <div class="endpoints">GET {ep}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8b. PRICING TRANSITION -->
  <section class="transition">
    <div class="art" aria-hidden="true">
      <img src={FA.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
      <img src={FB.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="wrap">
      <p class="eyebrow plain" style="justify-content:center">Matchup DNA</p>
      <h2>Two fighters. One matchup.<br /><span class="gold-em">Sixty derived metrics. One API.</span></h2>
      <p class="lede center">{FA.name} versus {FB.name} resolves to {flagship.meta.comparable} comparable metrics and {flagship.insights.length} threshold-cleared reads, each with its own sample and confidence.</p>
      <div class="actions-row" style="justify-content:center">
        <a class="btn primary" href="/pricing">See plans</a>
        <a class="btn secondary" href={`/workspace?tool=matchup&a=${FA_ID}&b=${FB_ID}`}>Run it in Workspace</a>
      </div>
      <p class="credit">{[FA.primary_image?.attribution_text, FB.primary_image?.attribution_text].filter(Boolean).join(" · ")}</p>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section class="section" id="plans">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Plans</p><h2>Not just UFC data.</h2><p class="lede">Every plan starts with normalized fight records. Pro unlocks fighter Fight DNA. Ultra unlocks Matchup DNA. Scale is production infrastructure.</p></div><a class="btn secondary" href="/pricing">Full pricing →</a></div>
      <div class="pricing-grid">
        {order.filter((k) => k !== "enterprise").map((k) => { const p = plans[k as keyof typeof plans] as any; return (
          <div class:list={["plan", { recommended: p.recommended }]}>
            {p.recommended && <span class="rec">Recommended</span>}
            <div class="tier">{p.name}</div>
            <div class="price">${p.price_usd_month}<small>/mo</small></div>
            <div class="pos">{p.tagline}</div>
            <div class="limits">{fmtNumber(p.included_requests)} req/mo<br />{p.rate_limit_per_min} req/min</div>
            <a class:list={["btn cta", p.recommended ? "gold" : "secondary"]} href={`/pricing#plan-${k}`}>{p.cta}</a>
          </div>
        ); })}
      </div>
    </div>
  </section>

  <!-- 10. FINAL -->
  <section class="final-cta transition">
    <div class="art" aria-hidden="true">
      <img src={fighterShow.fighter.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
      <img src={FB.primary_image?.card_url} alt="" width="800" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="wrap">
      <p class="eyebrow plain" style="justify-content:center">The engine behind a world-class UFC product</p>
      <h2>Every fighter. Every card.<br /><span class="gold-em">Every round. One API.</span></h2>
      <p class="lede center" style="margin:0 auto 26px">PropBetEdge UFC is one production application built on this intelligence layer. Build yours.</p>
      <div class="actions-row" style="justify-content:center">
        <a class="btn primary" href="/pricing">Get API access</a>
        <a class="btn secondary" href="/workspace">Open Workspace</a>
        <a class="btn ghost" href="https://ufc.propbetedge.ai" rel="noopener">See it in production →</a>
      </div>
      <p class="credit">{[fighterShow.fighter.primary_image?.attribution_text, FB.primary_image?.attribution_text].filter(Boolean).join(" · ")}</p>
    </div>
  </section>
</Base>
