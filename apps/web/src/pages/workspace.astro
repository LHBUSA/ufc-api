        $("run-c").addEventListener("click", async () => { let p = $("c-path").value.trim(); if (!p.startsWith("/v1/")) p = "/v1/ufc" + (p.startsWith("/") ? p : "/" + p); const l = await api(p); out(handle(l, (d) => generic(d))); });
