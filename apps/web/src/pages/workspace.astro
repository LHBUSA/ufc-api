---
import Base from "../layouts/Base.astro";
import gen from "../generated/entitlements.json";
import ex from "../generated/examples.json";
const plans = gen.plans.plans;
const sc = ex.showcase;
const art = {
  a: { id: sc.comain.fighters[0].id, name: sc.comain.fighters[0].name, img: sc.comain.fighters[0].primary_image?.card_url || null },
  b: { id: sc.comain.fighters[1].id, name: sc.comain.fighters[1].name, img: sc.comain.fighters[1].primary_image?.card_url || null },
  champ: { name: sc.rankings_womens_flyweight.division.champion.name, img: sc.rankings_womens_flyweight.division.champion.primary_image?.card_url || null },
  event: { name: sc.event.event.name, date: sc.event.event.event_date, bouts: sc.event.bout_count, a: sc.event.bouts[0]?.fighter_a?.primary_image?.card_url || null, b: sc.event.bouts[0]?.fighter_b?.primary_image?.card_url || null },
};
const jsonLd = [{ "@context": "https://schema.org", "@type": "WebApplication", name: "UFC Intelligence API Workspace", url: "https://ufc.proptechusa.ai/workspace", applicationCategory: "DeveloperApplication", operatingSystem: "Any", isPartOf: { "@id": "https://ufc.proptechusa.ai/#website" }, description: "In-browser developer workspace: search fighters, run Fight DNA and Matchup DNA, render cards and rankings, inspect requests and copy code." }];
---
<Base title="Workspace | PropTechUSA UFC Intelligence API" description="Test the UFC Intelligence API in your browser: fighter explorer, Matchup DNA builder, current card, rankings, Fight DNA, request inspector with copyable cURL, JavaScript and Python." path="/workspace" jsonLd={jsonLd} breadcrumbs={[{ name: "Workspace", path: "/workspace" }]}>
  <div class="wrap ws">
    <aside class="ws-rail" aria-label="Workspace tools" id="rail">
      <h5>Start</h5>
      <button data-tool="home">Workspace home</button>
      <button data-tool="card">Current Fight Week</button>
      <h5>Explore</h5>
      <button data-tool="fighter">Fighters</button>
      <button data-tool="events">Events</button>
      <button data-tool="rankings">Rankings</button>
      <h5>Intelligence</h5>
      <button data-tool="dna">Fight DNA</button>
      <button data-tool="matchup">Matchup DNA</button>
      <h5>Any endpoint</h5>
      <button data-tool="custom">Request builder</button>
    </aside>
    <div class="ws-main">
      <div class="ws-conn">
        <img src="/brand/ufc-api-mark.svg" width="28" height="28" alt="" />
        <input id="ws-key" type="password" autocomplete="off" spellcheck="false" placeholder="Paste your API key (pt_ufc_live_…)" aria-label="API key" />
        <button class="btn primary" id="ws-connect" type="button">Connect</button>
        <span class="ws-status" id="ws-status">Not connected</span>
        <a class="small" href="/pricing" id="ws-getkey">Need a key?</a>
      </div>
      <select class="ws-rail-select" id="rail-select" aria-label="Workspace tool">
        <option value="home">Workspace home</option><option value="card">Current Fight Week</option><option value="fighter">Fighters</option><option value="events">Events</option><option value="rankings">Rankings</option><option value="dna">Fight DNA</option><option value="matchup">Matchup DNA</option><option value="custom">Request builder</option>
      </select>
      <div class="ws-tool" id="ws-tool"></div>
      <div class="ws-result" id="ws-result" hidden>
        <div class="ws-tabs" role="tablist"><button role="tab" aria-selected="true" data-view="preview">Preview</button><button role="tab" aria-selected="false" data-view="json">JSON</button><span style="margin-left:auto" class="actions-row"><button class="btn ghost" id="ws-copy-json" type="button">Copy JSON</button><button class="btn ghost" id="ws-dl-json" type="button">Download</button></span></div>
        <div class="ws-out" id="ws-preview"></div>
        <pre class="ws-json" id="ws-jsonpre" hidden></pre>
        <div class="card flat" style="padding:14px">
          <p class="eyebrow" style="margin:0 0 8px">Request inspector</p>
          <div class="ws-inspect">
            <div><small>Request</small><b id="i-path">—</b></div><div><small>Status</small><b id="i-status">—</b></div><div><small>Latency</small><b id="i-latency">—</b></div><div><small>Plan</small><b id="i-plan">—</b></div><div><small>Rate limit</small><b id="i-rate">—</b></div><div><small>Request id</small><b id="i-rid">—</b></div>
          </div>
          <div class="actions-row" style="margin-top:10px"><button class="btn secondary" type="button" data-snip="curl">Copy cURL</button><button class="btn secondary" type="button" data-snip="js">Copy JS</button><button class="btn secondary" type="button" data-snip="py">Copy Python</button><span class="status-line" id="i-msg"></span></div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ PLAN_NAMES: Object.fromEntries(Object.entries(plans).map(([k, v]) => [k, (v as any).name])), ART: art }}>
    /* ===== UFC Workspace (client) — the key is stored in localStorage only and sent solely to this origin's /v1 and /dashboard/api routes. Never logged. ===== */
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const SIL = "/brand/fighter-silhouette.svg";
    const ORIGIN = location.origin;
    let KEY = ""; try { KEY = localStorage.getItem("ufc_ws_key") || ""; } catch {}
    let planKey = null; let last = null; let tool = "card"; let pick = { a: null, b: null, f: null, d: null }; let cache = {};
    const num = (v, d = 2) => (v === null || v === undefined ? "—" : Number(v).toLocaleString("en-US", { maximumFractionDigits: d }));
    const pct = (v) => (v === null || v === undefined ? "—" : Math.round(v * 100) + "%");
    const inch = (v) => (v === null || v === undefined ? "—" : v + '"');
    const rec = (f) => (f && f.record_w !== null && f.record_w !== undefined ? `${f.record_w}-${f.record_l ?? 0}-${f.record_d ?? 0}${f.record_nc ? ` (${f.record_nc} NC)` : ""}` : "—");
    const tc = (s) => (s ? String(s).toLowerCase().replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "—");
    const img = (f) => f?.primary_image?.card_url || f?.primary_image?.thumb_url || SIL;
    const credit = (f) => (f?.primary_image?.attribution_text ? `<div class="credit">${esc(f.primary_image.attribution_text)}</div>` : f?.primary_image ? "" : `<div class="credit">no portrait · silhouette</div>`);
    const rankOf = (f) => { const p = (f?.ranking?.positions || []).filter((x) => !x.is_p4p)[0]; return p ? (p.rank === 0 || p.is_champion ? "Champion" : `#${p.rank} ${tc(p.label)}`) : null; };
    const chip = (plan) => `<span class="chip plan-${plan}">${esc(PLAN_NAMES[plan] || plan)}+</span>`;

    function setStatus(text, cls) { const s = $("ws-status"); s.textContent = text; s.className = "ws-status" + (cls ? " " + cls : ""); }
    async function connect() {
      KEY = $("ws-key").value.trim();
      if (!KEY) return setStatus("Paste a key", "bad");
      setStatus("Connecting…");
      try {
        const r = await fetch("/dashboard/api/me", { headers: { authorization: `Bearer ${KEY}` } });
        const b = await r.json();
        if (!b.ok) { planKey = null; setStatus("Invalid key", "bad"); return; }
        planKey = b.data.plan.key; try { localStorage.setItem("ufc_ws_key", KEY); } catch {}
        setStatus(`Connected · ${b.data.plan.name} plan`, "ok"); $("ws-getkey").hidden = true;
      } catch { setStatus("Connection failed", "bad"); }
    }
    $("ws-connect").addEventListener("click", connect);
    $("ws-key").addEventListener("keydown", (e) => { if (e.key === "Enter") connect(); });
    if (KEY) { $("ws-key").value = KEY; connect(); }

    async function api(path) {
      if (!KEY) { setStatus("Connect a key first", "bad"); throw new Error("no_key"); }
      const t0 = performance.now();
      const r = await fetch(ORIGIN + path, { headers: { authorization: `Bearer ${KEY}`, accept: "application/json" } });
      const ms = Math.round(performance.now() - t0);
      const body = await r.json().catch(() => ({ ok: false, error: { code: "invalid_json", message: "Non-JSON response" } }));
      last = { path, status: r.status, ms, body, plan: r.headers.get("x-plan"), rl: r.headers.get("x-ratelimit-remaining"), rlMax: r.headers.get("x-ratelimit-limit"), q: r.headers.get("x-quota-remaining"), qMax: r.headers.get("x-quota-limit"), rid: r.headers.get("x-request-id") };
      inspect(last);
      return last;
    }
    function inspect(l) {
      $("ws-result").hidden = false;
      $("i-path").textContent = "GET " + l.path; $("i-status").textContent = String(l.status); $("i-latency").textContent = l.ms + " ms"; $("i-plan").textContent = l.plan || "—";
      $("i-rate").textContent = l.q && l.qMax ? `${Number(l.q).toLocaleString("en-US")} / ${l.qMax === "unlimited" ? "∞" : Number(l.qMax).toLocaleString("en-US")}` : l.rl ? `${l.rl}/${l.rlMax} per min` : "—";
      $("i-rid").textContent = l.rid || "—";
      $("ws-jsonpre").textContent = JSON.stringify(l.body, null, 2);
      showView("preview");
    }
    function showView(v) { document.querySelectorAll("[data-view]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.view === v))); $("ws-preview").hidden = v !== "preview"; $("ws-jsonpre").hidden = v !== "json"; }
    document.querySelectorAll("[data-view]").forEach((b) => b.addEventListener("click", () => showView(b.dataset.view)));
    $("ws-copy-json").addEventListener("click", async () => { try { await navigator.clipboard.writeText($("ws-jsonpre").textContent); $("i-msg").textContent = "JSON copied"; } catch {} });
    $("ws-dl-json").addEventListener("click", () => { const blob = new Blob([$("ws-jsonpre").textContent], { type: "application/json" }); const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "ufc-api-response.json"; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000); });
    document.querySelectorAll("[data-snip]").forEach((b) => b.addEventListener("click", async () => {
      if (!last) return; const url = ORIGIN + last.path; const k = b.dataset.snip;
      const s = k === "curl" ? `curl -H "Authorization: Bearer $UFC_API_KEY" "${url}"` : k === "js" ? `const res = await fetch("${url}", { headers: { Authorization: \`Bearer \${process.env.UFC_API_KEY}\` } });\nconst { ok, data, meta } = await res.json();` : `import os, requests\nres = requests.get("${url}", headers={"Authorization": f"Bearer {os.environ['UFC_API_KEY']}"})\nbody = res.json()`;
      try { await navigator.clipboard.writeText(s); $("i-msg").textContent = "Snippet copied (uses $UFC_API_KEY, never your literal key)"; } catch {}
    }));

    /* ---------- renderers (mirror the portal's preview components) ---------- */
    function gate(body) { const d = body?.error?.detail || {}; return `<div class="ws-gate"><b>${esc((d.required_plan || "higher").toUpperCase())} REQUIRED</b><div>${esc(body?.error?.message || "")}</div><div class="small muted">Your plan: ${esc(d.current_plan || planKey || "—")}. ${d.parameter ? `Parameter <code>${esc(d.parameter.name)}=${esc(d.parameter.value)}</code> is gated.` : ""}</div><div><a class="btn gold" href="${esc(d.upgrade_url || "/pricing")}">Upgrade →</a></div></div>`; }
    function errBox(body, status) { return `<div class="ws-err"><b>${status} ${esc(body?.error?.code || "error")}</b> — ${esc(body?.error?.message || "")}${body?.error?.detail ? `<div class="small mono" style="margin-top:4px">${esc(JSON.stringify(body.error.detail)).slice(0, 300)}</div>` : ""}</div>`; }
    function handle(l, render) { if (l.status === 403 && l.body?.error?.code === "plan_required") return gate(l.body); if (!l.body?.ok) return errBox(l.body, l.status); return render(l.body.data, l.body.meta); }
    function fighterCard(f, size = "card", extra = "") {
      const r = rankOf(f); const div = (f.ranking?.positions || []).filter((x) => !x.is_p4p)[0]?.label;
      return `<article class="fighter fighter-${size}"><figure class="fighter-figure"><img src="${esc(img(f))}" alt="${esc(f.name)}" width="800" height="1000" loading="lazy">${credit(f)}</figure><div class="fighter-body"><div class="fighter-name">${esc(f.name)}${f.nickname ? `<span class="fighter-nick">“${esc(f.nickname)}”</span>` : ""}</div><div class="fighter-sub">${div ? esc(tc(div)) : "—"}${r ? ` · <span class="rank">${esc(r)}</span>` : ""}</div><dl class="facts"><div><dt>Record</dt><dd>${rec(f)}</dd></div><div><dt>Height</dt><dd>${f.height_in ? `${Math.floor(f.height_in / 12)}'${f.height_in % 12}"` : "—"}</dd></div><div><dt>Reach</dt><dd>${inch(f.reach_in)}</dd></div><div><dt>Stance</dt><dd>${esc(tc(f.stance))}</dd></div><div><dt>Weight</dt><dd>${f.weight_lbs ? f.weight_lbs + " lb" : "—"}</dd></div><div><dt>Fights</dt><dd>${f.fight_history_count ?? "—"}</dd></div></dl>${f.next_bout?.event ? `<div class="next small"><span class="muted">Next:</span> ${esc(f.next_bout.event.name)} · ${esc(f.next_bout.event.event_date)}${f.next_bout.opponent ? ` · vs ${esc(f.next_bout.opponent.name)}` : ""}</div>` : ""}${extra}</div></article>`;
    }
    const DNA_LABELS = { sig_landed_per_min: ["Sig. strikes landed", "n", "/min"], sig_absorbed_per_min: ["Sig. strikes absorbed", "n", "/min"], sig_accuracy: ["Strike accuracy", "%"], sig_defense: ["Strike defense", "%"], td_attempts_per_15: ["TD attempts", "n", "/15"], td_landed_per_15: ["TD landed", "n", "/15"], td_accuracy: ["TD accuracy", "%"], control_share: ["Control share", "%"], sub_attempts_per_15: ["Sub attempts", "n", "/15"], knockdowns_per_15: ["Knockdowns", "n", "/15"], finish_rate: ["Finish rate", "%"], ko_finish_rate: ["KO finish rate", "%"], submission_finish_rate: ["Sub finish rate", "%"], pace_retention_r2_vs_r1: ["Pace R2/R1", "x"], pace_retention_r3_vs_r1: ["Pace R3/R1", "x"], head_attack_share: ["Head share", "%"], body_attack_share: ["Body share", "%"], leg_attack_share: ["Leg share", "%"], distance_attack_share: ["Distance share", "%"], clinch_attack_share: ["Clinch share", "%"], ground_attack_share: ["Ground share", "%"] };
    function mval(m, u, suffix = "") { if (!m || m.value === null || m.value === undefined) return "—"; return u === "%" ? pct(m.value) : u === "x" ? num(m.value, 2) + "×" : num(m.value, 2) + suffix; }
    function dnaPanel(s, keys) {
      if (!s) return `<div class="dna-panel"><div class="ws-empty">No snapshot.</div></div>`;
      keys = keys || ["sig_landed_per_min", "sig_accuracy", "sig_defense", "td_attempts_per_15", "td_accuracy", "finish_rate", "pace_retention_r3_vs_r1", "control_share", "knockdowns_per_15", "head_attack_share", "distance_attack_share", "sub_attempts_per_15"];
      const covered = s.sample_rounds > 0;
      return `<div class="dna-panel"><div class="dna-head"><div class="eyebrow gold" style="margin:0">Fight DNA <span class="chip derived">PBE derived</span></div><div class="mono small muted">as of ${esc(s.as_of_date)} · def v${s.definition_version}</div></div><div class="dna-metrics">${keys.map((k) => { const m = s.metrics?.[k]; const L = DNA_LABELS[k] || [k, "n"]; return `<div class="dna-metric${!m || m.value === null ? " none" : ""}"><b>${mval(m, L[1], L[2] || "")}</b><span>${esc(L[0])}</span><small class="conf conf-${m?.confidence || "insufficient"}">${esc(m?.confidence || "insufficient")}</small></div>`; }).join("")}</div><div class="dna-sample"><span><b>Coverage</b> ${esc(covered ? s.coverage_status : "insufficient")}</span><span>${s.sample_bouts} bouts · ${s.sample_rounds} rounds · ${num(s.sample_seconds / 60, 0)} min observed</span>${covered ? "" : `<span class="muted">No stat-covered rounds in scope: rate metrics are truthfully null.</span>`}</div></div>`;
    }
    function tape(m) {
      const [A, B] = m.fighters; const cmp = Object.fromEntries(m.comparisons.map((c) => [c.key, c]));
      const rows = [["sig_landed_per_min", "Pace (sig. landed/min)", "n"], ["sig_accuracy", "Strike accuracy", "%"], ["sig_defense", "Strike defense", "%"], ["distance_attack_share", "Distance share", "%"], ["td_attempts_per_15", "TD attempts /15", "n"], ["td_accuracy", "TD accuracy", "%"], ["control_seconds_per_td", "Control s / TD", "n"], ["pace_retention_r3_vs_r1", "Pace R3/R1", "x"], ["finish_rate", "Finish rate", "%"]];
      const side = (f, right) => `<div class="vs-fighter${right ? " right" : ""}"><figure class="fighter-figure"><img src="${esc(img(f))}" alt="${esc(f.name)}" width="800" height="1000" loading="lazy">${credit(f)}</figure><div><div class="fighter-name">${esc(f.name)}</div><div class="fighter-sub">${rec(f)} · ${esc(rankOf(f) || "Unranked")}</div></div></div>`;
      const show = (s, u) => mval(s, u);
      return `<div class="vs"><div class="vs-head">${side(A, false)}<div class="vs-badge">VS</div>${side(B, true)}</div><table class="tape"><tbody><tr><td>${inch(A.reach_in)}</td><th>Reach</th><td>${inch(B.reach_in)}</td></tr><tr><td>${esc(tc(A.stance))}</td><th>Stance</th><td>${esc(tc(B.stance))}</td></tr>${rows.map(([k, l, u]) => { const c = cmp[k]; return `<tr><td class="${c?.direction === "a" ? "win" : ""}">${show(c?.a, u)}</td><th>${esc(l)}<small class="muted">${esc(c?.a?.confidence || "—")} / ${esc(c?.b?.confidence || "—")}</small></th><td class="${c?.direction === "b" ? "win" : ""}">${show(c?.b, u)}</td></tr>`; }).join("")}</tbody></table><div class="vs-meta small muted">Stance context: <b>${esc(m.stance_context?.context?.replace(/_/g, " "))}</b>. “—” = no stat-covered rounds for that fighter. Reach, stance and rank composed from <code>/fighters/{id}</code>.</div>${m.insights?.length ? `<div class="reads"><div class="eyebrow gold" style="margin:0 0 6px">Matchup read <span class="chip derived">PBE derived</span></div><ul>${m.insights.map((i) => `<li><b>${esc(i.label)}.</b> ${esc(i.explanation)} <span class="conf conf-${esc(i.confidence)}">${esc(i.confidence)}</span></li>`).join("")}</ul></div>` : ""}${m.warnings?.length ? `<details class="small muted" style="margin-top:8px"><summary>${m.warnings.length} thresholds not met (warnings[])</summary><ul>${m.warnings.map((w) => `<li>${esc(w)}</li>`).join("")}</ul></details>` : ""}<div class="small muted" style="margin-top:8px">${esc(m.note || "")}</div></div>`;
    }
    function eventCard(d) {
      const bouts = [...d.bouts].sort((a, b) => b.bout_order - a.bout_order); const main = bouts[0];
      const sideM = (f, right) => `<div class="main-side${right ? " right" : ""}"><img src="${esc(img(f))}" alt="${esc(f.name)}" width="64" height="80" loading="lazy"><div><div class="fighter-name">${esc(f.name)}</div><div class="fighter-sub">${rec(f)} · ${esc(tc(f.stance))}</div>${credit(f)}</div></div>`;
      const group = (pos) => bouts.filter((b) => b !== main && (b.card_position || "main") === pos);
      const list = (title, arr) => arr.length ? `<div class="eyebrow" style="margin:14px 0 6px">${title}</div><ol class="bout-list">${arr.map((b) => `<li><span class="mono small muted">${b.is_title ? "Title · " : ""}${b.scheduled_rounds}R</span><span class="bout-names">${esc(b.fighter_a.name)} <em>vs</em> ${esc(b.fighter_b.name)}</span><span class="small muted">${esc(tc(b.weight_class))}${b.is_womens ? " (W)" : ""}${b.result ? ` · ${esc(b.result.method || "result")}` : ""}</span></li>`).join("")}</ol>` : "";
      const positions = [...new Set(bouts.map((b) => b.card_position || "main"))];
      return `<div class="card-preview"><div class="event-head"><div><div class="eyebrow" style="margin:0">${esc(d.event.event_date)} · ${esc(d.event.venue || "")}${d.event.city ? ", " + esc(d.event.city) : ""}</div><h3 style="margin:4px 0 0">${esc(d.event.name)}</h3></div><div class="event-meta mono small"><span class="chip">${esc(d.event.card_status || "")}</span><span>${d.bouts.length} bouts</span></div></div>${main ? `<div class="main-event"><div class="eyebrow gold" style="margin:0 0 8px">Main event · ${esc(tc(main.weight_class))}${main.is_title ? " · Title" : ""} · ${main.scheduled_rounds} rounds</div><div class="main-row">${sideM(main.fighter_a, false)}<div class="vs-badge">VS</div>${sideM(main.fighter_b, true)}</div></div>` : ""}${positions.map((p) => list(tc(p) + (p === "main" ? " card" : ""), group(p))).join("")}</div>`;
    }
    function rankingsView(d) {
      return d.divisions.map((dv) => `<div class="rank-preview"><div class="event-head"><div><div class="eyebrow" style="margin:0">${esc(dv.label)}${dv.is_womens ? " (W)" : ""} · snapshot ${esc(d.snapshot_date)}</div><h3 style="margin:4px 0 0">${dv.champion ? esc(dv.champion.name) : (dv.is_p4p ? "Pound-for-pound" : "Vacant")} ${dv.champion ? '<span class="chip plan-scale">Champion</span>' : ""}</h3></div><div class="small muted"><a href="${esc(d.source_url)}" rel="noopener">${esc(d.source)}</a> <span class="chip source">Source</span></div></div><ol class="rank-list">${dv.entries.map((e) => `<li><span class="rank-n">${e.rank}</span><span class="rank-name">${e.fighter ? `<a href="#" data-open-fighter="${esc(e.fighter.id)}">${esc(e.name)}</a>` : esc(e.name)}${e.is_new ? ' <span class="chip">new</span>' : ""}</span><span class="rank-move ${e.change > 0 ? "up" : e.change < 0 ? "down" : ""}">${e.change > 0 ? "▲ " + e.change : e.change < 0 ? "▼ " + Math.abs(e.change) : "–"}</span></li>`).join("")}</ol></div>`).join("<div style='height:16px'></div>");
    }
    function historyView(d) { const rows = d.bouts || d.history || []; return rows.length ? `<ul class="hist-list">${rows.map((h) => `<li><span class="outcome ${esc(h.outcome || "none")}">${esc(h.outcome || "—")}</span><span><b>${esc(h.opponent?.name || "TBA")}</b><br><span class="small muted">${esc(h.event?.name || "")} · ${esc(h.event?.event_date || "")} · ${esc(tc(h.weight_class))}</span></span><span class="small muted">${esc(h.result?.method || (h.outcome ? "" : "scheduled"))}${h.result?.round ? ` · R${h.result.round} ${esc(h.result.time || "")}` : ""}</span></li>`).join("")}</ul>` : `<div class="ws-empty">No bouts.</div>`; }
    function statsView(d) {
      const cr = d.computed?.career_rates || {}; const p = d.computed?.provenance || {};
      const items = [["sig_str_landed_per_min", "Sig. landed /min", "n"], ["sig_str_accuracy", "Sig. accuracy", "%"], ["td_per_15min", "TD /15", "n"], ["td_accuracy", "TD accuracy", "%"], ["kd_per_15min", "KD /15", "n"], ["ctrl_share", "Control share", "%"], ["head_share", "Head share", "%"], ["distance_share", "Distance share", "%"]];
      return `<div class="dna-panel" style="background:var(--surface);border-color:var(--line)"><div class="dna-head"><div class="eyebrow" style="margin:0">Computed career rates <span class="chip derived">PBE derived</span></div><div class="mono small muted">${p.bouts_with_stats ?? 0} bouts with stats · ${p.rounds ?? 0} rounds</div></div><div class="dna-metrics">${items.map(([k, l, u]) => `<div class="dna-metric${cr[k] === null || cr[k] === undefined ? " none" : ""}"><b>${cr[k] === null || cr[k] === undefined ? "—" : u === "%" ? pct(cr[k]) : num(cr[k], 2)}</b><span>${esc(l)}</span></div>`).join("")}</div><div class="dna-sample"><span class="muted">${esc(p.coverage_note || d.warning || "")}</span></div></div>${d.career_snapshot ? `<div class="career" style="margin-top:12px"><div class="eyebrow" style="margin:0 0 6px;font-size:.64rem">Career snapshot (display) <span class="chip source">Source</span></div><div class="career-grid">${Object.entries(d.career_snapshot).map(([k, v]) => `<div><b>${v ?? "—"}</b><span>${esc(k.replace(/_/g, " "))}</span></div>`).join("")}</div></div>` : ""}<div class="small muted" style="margin-top:10px">${(d.round_stats || []).length} round rows in <code>round_stats[]</code> (see JSON).</div>`;
    }
    function mediaView(f, vids) {
      const imgs = f.images || (f.primary_image ? [f.primary_image] : []);
      return `<div class="eyebrow">Images <span class="chip media">Media</span></div>${imgs.length ? `<div class="media-grid">${imgs.map((i) => `<figure><img src="${esc(i.card_url || i.image_url)}" alt="${esc(f.name)}" width="800" height="1000" loading="lazy"><figcaption class="credit">${esc(i.attribution_text || [i.author, i.license].filter(Boolean).join(", "))}${i.source_url ? ` · <a href="${esc(i.source_url)}" rel="noopener">source</a>` : ""}</figcaption></figure>`).join("")}</div>` : `<div class="ws-empty">No rights-cleared images for this fighter.</div>`}<div class="eyebrow" style="margin-top:16px">Official videos <span class="chip link">Third-party link</span></div>${vids?.length ? `<ul class="video-list">${vids.map((v) => `<li><img src="${esc(v.thumbnail_url || "")}" alt="" width="96" height="54" loading="lazy"><div><a href="${esc(v.url)}" rel="noopener">${esc(v.title)}</a><div class="small muted">${esc(v.attribution)} · ${esc(v.video_type_label || v.video_type || "")} · ${esc((v.published_at || "").slice(0, 10))}</div></div></li>`).join("")}</ul>` : `<div class="ws-empty">No published videos linked.</div>`}`;
    }
