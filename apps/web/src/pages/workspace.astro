          </div>`;
        root.querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => { history.replaceState(null, "", `/workspace?tool=${b.dataset.go}`); open(b.dataset.go); window.scrollTo({ top: 0, behavior: "smooth" }); }));
      } },
      card: { title: "Current card", desc: "Zero-configuration first test: the next upcoming event and its full card.", render(root) {
        root.innerHTML = `<h3>Current card</h3><p class="small muted">GET /v1/ufc/events?status=upcoming&limit=1 → GET /v1/ufc/events/{id}/card</p><div class="actions-row"><button class="btn primary" id="run-card" type="button">Run current card</button></div>`;
        $("run-card").addEventListener("click", async () => { const e = await api("/v1/ufc/events?status=upcoming&limit=1"); if (!e.body?.ok || !e.body.data?.length) return out(handle(e, () => `<div class="ws-empty">No upcoming events.</div>`)); const id = e.body.data[0].id; const c = await api(`/v1/ufc/events/${id}/card?include=media,results`); out(handle(c, eventCard)); });
        if (new URLSearchParams(location.search).get("tool") === "card") setTimeout(() => KEY && $("run-card").click(), 300);
      } },
      events: { title: "Events", render(root) {
        root.innerHTML = `<h3>Events</h3><div class="ws-form"><div class="ws-two"><select id="ev-status"><option value="upcoming">Upcoming</option><option value="recent">Recent</option><option value="all">All</option></select><input type="text" id="ev-limit" value="10" aria-label="limit"></div><div class="actions-row"><button class="btn primary" id="run-ev" type="button">List events</button></div><div id="ev-list"></div></div>`;
        $("run-ev").addEventListener("click", async () => { const l = await api(`/v1/ufc/events?status=${$("ev-status").value}&limit=${encodeURIComponent($("ev-limit").value || 10)}`); out(handle(l, (d) => `<div class="table-wrap"><table class="ws-table"><thead><tr><th>Date</th><th>Event</th><th>Venue</th><th>Status</th><th></th></tr></thead><tbody>${d.map((e) => `<tr><td class="mono small">${esc(e.event_date)}</td><td><b>${esc(e.name)}</b></td><td class="small">${esc(e.venue || "")}${e.city ? ", " + esc(e.city) : ""}</td><td><span class="chip">${esc(e.card_status || "")}</span></td><td><button class="btn ghost" type="button" data-card="${esc(e.id)}">Card →</button></td></tr>`).join("")}</tbody></table></div>`)); $("ws-preview").querySelectorAll("[data-card]").forEach((b) => b.addEventListener("click", async () => { const c = await api(`/v1/ufc/events/${b.dataset.card}/card?include=media,results`); out(handle(c, eventCard)); })); });
      } },
      fighter: { title: "Fighters", render(root) {
        root.innerHTML = `<h3>Fighter explorer</h3><p class="small muted">Search by name; no UUIDs needed. Tabs run the relevant endpoint.</p><div class="ws-form"><div id="f-search"></div><div id="f-pick"></div><div class="ws-tabs" id="f-tabs" hidden><button data-ft="overview" aria-selected="true">Overview</button><button data-ft="history">History</button><button data-ft="stats">Stats ${chip("pro")}</button><button data-ft="dna">Fight DNA ${chip("pro")}</button><button data-ft="media">Media</button></div></div>`;
        const run = async (ft) => { const f = pick.f; if (!f) return; $("f-tabs").querySelectorAll("[data-ft]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.ft === ft)));
          if (ft === "overview") { const l = await api(`/v1/ufc/fighters/${f.id}?include=ranking,next`); out(handle(l, (d) => fighterCard(d, "hero", d.career_slpm !== null && d.career_slpm !== undefined ? `<div class="career"><div class="eyebrow" style="margin:0 0 6px;font-size:.64rem">Career stats <span class="chip source">Source</span></div><div class="career-grid"><div><b>${d.career_slpm}</b><span>SLpM</span></div><div><b>${d.career_str_acc}%</b><span>Str acc</span></div><div><b>${d.career_sapm}</b><span>SApM</span></div><div><b>${d.career_str_def}%</b><span>Str def</span></div><div><b>${d.career_td_avg}</b><span>TD avg</span></div><div><b>${d.career_td_acc}%</b><span>TD acc</span></div><div><b>${d.career_td_def}%</b><span>TD def</span></div><div><b>${d.career_sub_avg}</b><span>Sub avg</span></div></div></div>` : ""))); }
          if (ft === "history") { const l = await api(`/v1/ufc/fighters/${f.id}/history?limit=25`); out(handle(l, historyView)); }
