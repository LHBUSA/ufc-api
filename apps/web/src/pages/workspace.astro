      } },
      dna: { title: "Fight DNA", render(root) {
        root.innerHTML = `<h3>Fight DNA ${chip("pro")}</h3><p class="small muted">Snapshot, stance splits, round profile and finish profile. Add an as-of date to reconstruct history.</p><div class="ws-form"><div id="d-search"></div><div id="d-pick"></div><div class="ws-two"><input type="text" id="d-asof" placeholder="as_of (YYYY-MM-DD, optional)" aria-label="as of"><select id="d-fam"><option value="dna">Snapshot</option><option value="splits">Stance splits</option><option value="round-profile">Round profile</option><option value="finish-profile">Finish profile</option><option value="position-profile">Position profile</option></select></div><div class="actions-row"><button class="btn primary" id="run-dna" type="button">Run</button></div></div>`;
        $("d-search").appendChild(searchBox("d", "Search fighters", (f) => { pick.d = f; $("d-pick").innerHTML = pickHtml(f); }));
        $("run-dna").addEventListener("click", async () => { const f = pick.d; if (!f) return; const fam = $("d-fam").value; const asof = $("d-asof").value.trim(); const q = asof ? `?as_of=${encodeURIComponent(asof)}` : ""; const l = await api(`/v1/ufc/fighters/${f.id}/${fam}${q}`);
          out(handle(l, (d, meta) => fam === "dna" ? `${fighterCard(d.fighter, "mini")}<div class="small muted" style="margin:8px 0">requested_as_of ${esc(meta?.requested_as_of || "—")} → resolved ${esc(meta?.resolved_as_of || "—")}</div>${dnaPanel(d.snapshot)}` : fam === "splits" ? `<div class="table-wrap"><table class="ws-table"><thead><tr><th>Opponent stance</th><th>Record</th><th>Finish</th><th>KO</th><th>Sub</th><th>Sig diff/min</th><th>Conf</th></tr></thead><tbody>${(d.splits || (d.split ? [d.split] : [])).map((s) => `<tr><td>${esc(tc(s.opponent_stance))}</td><td>${s.record ? `${s.record.w}-${s.record.l}-${s.record.d}` : "—"}</td><td>${mval(s.metrics?.finish_rate, "%")}</td><td>${mval(s.metrics?.ko_rate, "%")}</td><td>${mval(s.metrics?.sub_rate, "%")}</td><td>${mval(s.metrics?.sig_diff_per_min, "n")}</td><td class="conf conf-${esc(s.confidence || "insufficient")}">${esc(s.confidence || "—")}</td></tr>`).join("")}</tbody></table></div>` : `${fighterCard(d.fighter, "mini")}<div class="small muted" style="margin:8px 0">status <b>${esc(d.status)}</b> · available ${d.available} · ${esc(d.note || "")}</div>${d[fam.replace("-", "_")] ? generic(d[fam.replace("-", "_")]) : `<div class="ws-empty">Family is null (${esc(d.status)}).</div>`}`)); });
        const id = new URLSearchParams(location.search).get("id"); if (id && KEY) fighterById(id).then((f) => { if (f) { pick.d = f; $("d-pick").innerHTML = pickHtml(f); $("run-dna").click(); } });
      } },
      matchup: { title: "Matchup DNA", render(root) {
