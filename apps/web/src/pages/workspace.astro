      } },
      rankings: { title: "Rankings", render(root) {
        const divs = ["P4P", "FLYWEIGHT", "BANTAMWEIGHT", "FEATHERWEIGHT", "LIGHTWEIGHT", "WELTERWEIGHT", "MIDDLEWEIGHT", "LIGHT_HEAVYWEIGHT", "HEAVYWEIGHT"];
        root.innerHTML = `<h3>Rankings</h3><div class="ws-form"><div class="ws-two"><select id="r-div"><option value="">All divisions</option>${divs.map((d) => `<option value="${d}">${tc(d)}</option>`).join("")}</select><select id="r-w"><option value="">Men + women</option><option value="false">Men</option><option value="true">Women</option></select></div><div class="actions-row"><button class="btn primary" id="run-r" type="button">Load rankings</button></div></div>`;
        $("run-r").addEventListener("click", async () => { const q = []; if ($("r-div").value) q.push("division=" + $("r-div").value); if ($("r-w").value) q.push("womens=" + $("r-w").value); const l = await api(`/v1/ufc/rankings${q.length ? "?" + q.join("&") : ""}`); out(handle(l, rankingsView)); $("ws-preview").querySelectorAll("[data-open-fighter]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); location.href = `/workspace?tool=fighter&id=${a.dataset.openFighter}`; })); });
        const d = new URLSearchParams(location.search).get("division"); if (d) { $("r-div").value = d; if (KEY) setTimeout(() => $("run-r").click(), 300); }
