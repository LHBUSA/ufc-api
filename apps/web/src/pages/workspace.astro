      if (data && typeof data === "object") return `<dl class="ws-kv">${Object.entries(data).map(([k, v]) => `<dt>${esc(k)}</dt><dd>${typeof v === "object" && v !== null ? `<code>${esc(JSON.stringify(v)).slice(0, 160)}${JSON.stringify(v).length > 160 ? "…" : ""}</code>` : esc(String(v))}</dd>`).join("")}</dl>`;
      return `<pre class="ws-json">${esc(JSON.stringify(data, null, 2))}</pre>`;
    }
    const out = (html) => { $("ws-preview").innerHTML = html; showView("preview"); };

    /* ---------- fighter search ---------- */
    function searchBox(id, placeholder, onPick) {
      const wrap = document.createElement("div"); wrap.className = "ws-search";
      wrap.innerHTML = `<input type="text" autocomplete="off" placeholder="${esc(placeholder)}" aria-label="${esc(placeholder)}"><div class="ws-ac" hidden></div>`;
      const inp = wrap.querySelector("input"), ac = wrap.querySelector(".ws-ac"); let t;
      inp.addEventListener("input", () => { clearTimeout(t); const q = inp.value.trim(); if (q.length < 2) { ac.hidden = true; return; } t = setTimeout(async () => { try { const r = await fetch(ORIGIN + `/v1/ufc/fighters?q=${encodeURIComponent(q)}&limit=8`, { headers: { authorization: `Bearer ${KEY}` } }); const b = await r.json(); if (!b.ok) { ac.innerHTML = `<button type="button" disabled>${esc(b.error?.message || "Search failed")}</button>`; ac.hidden = false; return; } const rows = b.data || []; ac.innerHTML = rows.length ? rows.map((f) => `<button type="button" data-id="${esc(f.id)}"><img src="${esc(img(f))}" alt=""><span><b>${esc(f.name)}</b><small>${rec(f)} · ${esc(tc(f.stance))} · ${f.is_active === false ? "inactive" : "active"}</small></span></button>`).join("") : `<button type="button" disabled>No fighters match “${esc(q)}”</button>`; ac.hidden = false; ac.querySelectorAll("button[data-id]").forEach((btn) => btn.addEventListener("click", () => { const f = rows.find((x) => x.id === btn.dataset.id); ac.hidden = true; inp.value = f.name; onPick(f); })); } catch { ac.hidden = true; } }, 220); });
