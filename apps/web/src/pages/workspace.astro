    const pickHtml = (f) => (f ? `<div class="ws-pick"><img src="${esc(img(f))}" alt=""><b>${esc(f.name)}</b><span class="small muted">${rec(f)}</span></div>` : "");

    /* ---------- tools ---------- */
    async function fighterById(id) { if (cache["f:" + id]) return cache["f:" + id]; const l = await api(`/v1/ufc/fighters/${encodeURIComponent(id)}?include=ranking,next`); if (l.body?.ok) cache["f:" + id] = l.body.data; return l.body?.ok ? l.body.data : null; }
