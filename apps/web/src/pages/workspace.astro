    function open(name) { tool = tools[name] ? name : "home"; document.querySelectorAll("#rail [data-tool]").forEach((b) => b.setAttribute("aria-current", String(b.dataset.tool === tool))); $("rail-select").value = tool; $("ws-result").hidden = true; $("ws-preview").innerHTML = ""; last = null; tools[tool].render($("ws-tool")); }
