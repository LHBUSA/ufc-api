        root.innerHTML = `<div class="section-head" style="margin:0"><div><h3>Run the API on real fights.</h3><p class="small muted" style="margin:6px 0 0">${KEY ? "Pick a starting point. Every panel renders the product first; JSON stays one tab away." : "Connect your API key above, then pick a starting point."}</p></div></div>
          <div class="ws-home">
