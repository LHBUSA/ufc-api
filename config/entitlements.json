{
  "$note": "Every commercial endpoint maps to exactly one feature. A plan is entitled to an endpoint when its feature list (config/plans.json) contains that feature, or '*'. Anything NOT listed here is denied at the gateway with 404 route_not_found: the commercial layer may expose FEWER upstream routes than the canonical API, never more, and never a different shape. Parameter-level gates (include=, as_of=) are listed under param_gates. docs/UFC_API_ENTITLEMENTS.md is generated from this file.",
  "feature_labels": {
    "core": "Core UFC data",
    "editorial": "PropBetEdge editorial",
    "media_metadata": "Fighter image metadata with license and attribution",
    "video_metadata": "Official video metadata: ids, official URLs, channel, links (no rehosting)",
    "dna_registry": "Fight DNA metric registry: definitions, confidence tiers, as-of semantics (definitions only, no values)",
    "round_stats_deep": "Computed career rates and per-bout round aggregates",
    "dna_fighter": "Fighter Fight DNA: stance, striking, grappling, finish, round, context",
    "dna_as_of": "As-of reconstruction of fighter snapshots (?as_of=)",
    "dna_matchup": "Matchup DNA: fighter-vs-fighter comparisons, stance context, threshold-gated insights",
    "dna_query": "Cross-fighter Fight DNA query",
    "fight_week": "Fight State Ledger and event intelligence",
    "bulk_media_lookup": "Bulk media lookups at Scale volumes",
    "wire": "Third-party headline wire (REVIEW REQUIRED; not on self-serve plans)",
    "priority_support": "Priority support (not an endpoint)",
    "custom": "Custom endpoints (Enterprise only)"
  },
  "endpoints": [
    { "key": "index", "method": "GET", "path": "/v1/ufc", "feature": "core", "origin": "SOURCE_FACT", "summary": "API index", "cache": "historical" },
    { "key": "events", "method": "GET", "path": "/v1/ufc/events", "feature": "core", "origin": "SOURCE_FACT", "summary": "List events (upcoming, recent, all, by date)", "cache": "fresh" },
    { "key": "event", "method": "GET", "path": "/v1/ufc/events/{id}", "feature": "core", "origin": "SOURCE_FACT", "summary": "Event by UUID, UFCStats id or ESPN id", "cache": "historical" },
    { "key": "event_card", "method": "GET", "path": "/v1/ufc/events/{id}/card", "feature": "core", "origin": "SOURCE_FACT", "summary": "Event plus its ordered fight card", "cache": "fresh" },
    { "key": "event_articles", "method": "GET", "path": "/v1/ufc/events/{id}/articles", "feature": "editorial", "origin": "EDITORIAL", "summary": "PropBetEdge articles for an event", "cache": "fresh" },
    { "key": "event_videos", "method": "GET", "path": "/v1/ufc/events/{id}/videos", "feature": "video_metadata", "origin": "THIRD_PARTY_LINK", "summary": "Official video metadata for an event, grouped for the fight-week timeline", "cache": "fresh" },
    { "key": "event_intelligence", "method": "GET", "path": "/v1/ufc/events/{id}/intelligence", "feature": "fight_week", "origin": "PBE_DERIVED", "summary": "Fight Week intelligence per bout from the Fight State Ledger", "cache": "fresh" },
    { "key": "fighters", "method": "GET", "path": "/v1/ufc/fighters", "feature": "core", "origin": "SOURCE_FACT", "summary": "Search and list fighters", "cache": "historical" },
    { "key": "fighters_media", "method": "GET", "path": "/v1/ufc/fighters/media", "feature": "media_metadata", "origin": "MEDIA", "summary": "Bulk primary_image map (max 150 ids)", "cache": "historical" },
    { "key": "fighter", "method": "GET", "path": "/v1/ufc/fighters/{id}", "feature": "core", "origin": "SOURCE_FACT", "summary": "Fighter profile composite (include=media,ranking,next,history,stats,videos)", "cache": "historical" },
    { "key": "fighter_history", "method": "GET", "path": "/v1/ufc/fighters/{id}/history", "feature": "core", "origin": "SOURCE_FACT", "summary": "Fighter bout history", "cache": "historical" },
    { "key": "fighter_stats", "method": "GET", "path": "/v1/ufc/fighters/{id}/stats", "feature": "round_stats_deep", "origin": "PBE_DERIVED", "summary": "Career round rows plus computed rates and per-bout aggregates", "cache": "historical" },
    { "key": "fighter_articles", "method": "GET", "path": "/v1/ufc/fighters/{id}/articles", "feature": "editorial", "origin": "EDITORIAL", "summary": "PropBetEdge articles for a fighter", "cache": "fresh" },
    { "key": "fighter_videos", "method": "GET", "path": "/v1/ufc/fighters/{id}/videos", "feature": "video_metadata", "origin": "THIRD_PARTY_LINK", "summary": "Official video metadata for a fighter", "cache": "fresh" },
    { "key": "fighter_dna", "method": "GET", "path": "/v1/ufc/fighters/{id}/dna", "feature": "dna_fighter", "origin": "PBE_DERIVED", "summary": "Fighter Fight DNA snapshot (metrics, stance splits, round, finish, context)", "cache": "dna" },
    { "key": "fighter_splits", "method": "GET", "path": "/v1/ufc/fighters/{id}/splits", "feature": "dna_fighter", "origin": "PBE_DERIVED", "summary": "Stance DNA split rows", "cache": "dna" },
    { "key": "fighter_round_profile", "method": "GET", "path": "/v1/ufc/fighters/{id}/round-profile", "feature": "dna_fighter", "origin": "PBE_DERIVED", "summary": "Round DNA profile", "cache": "dna" },
    { "key": "fighter_finish_profile", "method": "GET", "path": "/v1/ufc/fighters/{id}/finish-profile", "feature": "dna_fighter", "origin": "PBE_DERIVED", "summary": "Finish DNA profile", "cache": "dna" },
    { "key": "fighter_position_profile", "method": "GET", "path": "/v1/ufc/fighters/{id}/position-profile", "feature": "dna_fighter", "origin": "LICENSED", "summary": "Position profile (licensed family; explicit unavailable until a licensed source exists)", "cache": "dna" },
    { "key": "bout", "method": "GET", "path": "/v1/ufc/bouts/{id}", "feature": "core", "origin": "SOURCE_FACT", "summary": "Bout detail", "cache": "historical" },
    { "key": "bout_stats", "method": "GET", "path": "/v1/ufc/bouts/{id}/stats", "feature": "core", "origin": "SOURCE_FACT", "summary": "Round-level statistics for a bout", "cache": "historical" },
    { "key": "bout_videos", "method": "GET", "path": "/v1/ufc/bouts/{id}/videos", "feature": "video_metadata", "origin": "THIRD_PARTY_LINK", "summary": "Official video metadata for a bout", "cache": "fresh" },
    { "key": "bout_ledger", "method": "GET", "path": "/v1/ufc/bouts/{id}/ledger", "feature": "fight_week", "origin": "PBE_DERIVED", "summary": "Fight State Ledger snapshots and deterministic diffs", "cache": "fresh" },
    { "key": "matchup_dna", "method": "GET", "path": "/v1/ufc/matchups/{fighterA}/{fighterB}/dna", "feature": "dna_matchup", "origin": "PBE_DERIVED", "summary": "Matchup DNA", "cache": "dna" },
    { "key": "results", "method": "GET", "path": "/v1/ufc/results", "feature": "core", "origin": "SOURCE_FACT", "summary": "Recent results", "cache": "fresh" },
    { "key": "rankings", "method": "GET", "path": "/v1/ufc/rankings", "feature": "core", "origin": "SOURCE_FACT", "summary": "Official rankings snapshot (ufc.com)", "cache": "fresh" },
    { "key": "news", "method": "GET", "path": "/v1/ufc/news", "feature": "editorial", "origin": "EDITORIAL", "summary": "PropBetEdge newsroom list", "cache": "fresh" },
    { "key": "article", "method": "GET", "path": "/v1/ufc/articles/{slug}", "feature": "editorial", "origin": "EDITORIAL", "summary": "PropBetEdge article", "cache": "fresh" },
    { "key": "wire", "method": "GET", "path": "/v1/ufc/wire", "feature": "wire", "origin": "THIRD_PARTY_LINK", "summary": "Third-party headline wire (Enterprise / first-party only pending rights review)", "cache": "wire" },
    { "key": "search", "method": "GET", "path": "/v1/ufc/search", "feature": "core", "origin": "SOURCE_FACT", "summary": "Search fighters, events and articles", "cache": "fresh" },
    { "key": "counts", "method": "GET", "path": "/v1/ufc/counts", "feature": "core", "origin": "SOURCE_FACT", "summary": "Coverage counts", "cache": "fresh" },
    { "key": "videos", "method": "GET", "path": "/v1/ufc/videos", "feature": "video_metadata", "origin": "THIRD_PARTY_LINK", "summary": "Official video metadata feed", "cache": "fresh" },
    { "key": "dna_metrics", "method": "GET", "path": "/v1/ufc/dna/metrics", "feature": "dna_registry", "origin": "PBE_DERIVED", "summary": "Fight DNA metric registry", "cache": "dna" },
    { "key": "dna_query", "method": "GET", "path": "/v1/ufc/dna/query", "feature": "dna_query", "origin": "PBE_DERIVED", "summary": "Cross-fighter Fight DNA query", "cache": "dna" }
  ],
  "param_gates": [
    { "endpoint": "event_card", "param": "include", "value": "stats", "feature": "round_stats_deep", "note": "adds round_stats[] and stat_totals to every bout" },
    { "endpoint": "fighter", "param": "include", "value": "stats", "feature": "round_stats_deep", "note": "adds computed career rates to the fighter composite" },
    { "endpoint": "fighter_dna", "param": "as_of", "value": "*", "feature": "dna_as_of", "note": "historical as-of reconstruction" },
    { "endpoint": "fighter_splits", "param": "as_of", "value": "*", "feature": "dna_as_of", "note": "historical as-of reconstruction" },
    { "endpoint": "fighter_round_profile", "param": "as_of", "value": "*", "feature": "dna_as_of", "note": "historical as-of reconstruction" },
    { "endpoint": "fighter_finish_profile", "param": "as_of", "value": "*", "feature": "dna_as_of", "note": "historical as-of reconstruction" },
    { "endpoint": "fighter_position_profile", "param": "as_of", "value": "*", "feature": "dna_as_of", "note": "historical as-of reconstruction" }
  ]
}
